#!/usr/bin/env python3
"""Build S6 peer-fix cards from configured s6_peers.

Reads cfg.s6_peers from output/<slug>/target.toml, mines security-relevant
fix commits from each peer via OSV and any locally available peer clones, and
emits evidence-bearing S6 work cards as JSONL matching the patch-cards.jsonl
shape. The audit agent resolves each candidate to an exact fix, then distills
and maps it across the full target tree before opening a hypothesis.

Hooks into bin/audit alongside bin/patch-cards. Failure of any peer or source
is non-fatal — the orchestrator emits whatever it could produce and exits 0
unless the target config itself is broken.

Output: <RESULTS_DIR>/s6-peer-cards.jsonl
Cache:  <RESULTS_DIR>/.s6-cache/  (OSV responses, refreshed weekly)
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
from itertools import zip_longest
from pathlib import Path

# .absolute() not .resolve() for the file-based fallback: inside a
# benchmark cell facade bin/ is a symlink to the real tree; .resolve()
# would chase it and make us read the wrong output/<slug>/target.toml.
ROOT = Path(os.environ["SCRIPT_ROOT"]).resolve() if os.environ.get("SCRIPT_ROOT") \
    else Path(__file__).absolute().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import peer_sources  # noqa: E402
import target_config as tc  # noqa: E402
import workqueue  # noqa: E402


def build_s6_card(
    target_slug: str,
    peer: str,
    fix_entry: dict,
    diff_excerpt: str = "",
) -> dict:
    source = str(fix_entry.get("source", ""))
    # Identify the card by what the entry *is*: an advisory by its id, a mined
    # commit by its hash. Keying an advisory on its range endpoint both merged
    # distinct advisories and let one card id later stand for a different one.
    identity = (
        str(fix_entry.get("id", "")) if source == "osv"
        else str(fix_entry.get("fix_hash") or fix_entry.get("id", ""))
    )
    raw_id = f"{target_slug}:{peer}:{source}:{identity}"
    card_id = "S6-PEER-" + hashlib.sha1(raw_id.encode("utf-8")).hexdigest()[:12]
    score = 40
    if source == "osv" and (
        fix_entry.get("evidence_kind") != "fixed-range" or not diff_excerpt
    ):
        score = 15
    return {
        "id": card_id,
        "kind": "s6-peer-fix",
        "target_slug": target_slug,
        # No target file: the agent maps the fix across the whole tree. Both
        # fields come from the shared helpers so an S6 card carries the same
        # unmapped-card shape every other consumer already expects.
        "subsystem": workqueue.subsystem_for(""),
        "file": "",
        "function": "",
        "mode": workqueue.mode_for_file(""),
        "strategy": "S6",
        "score": score,
        "seed": "",
        "patch_cards": [],
        "reason": (
            f"S6 peer-fix mining: {peer} "
            f"{workqueue.peer_revision_kind(source).lower()} "
            f"{str(fix_entry.get('id', ''))[:24]} ({source})"
        ),
        "status": "unclaimed",
        "created_at": workqueue.now_iso(),
        "peer_project": peer,
        "peer_fix_id": fix_entry.get("id", ""),
        "peer_fix_hash": fix_entry.get("fix_hash", ""),
        "peer_fix_url": fix_entry.get("url", ""),
        "peer_repo_url": fix_entry.get("repo_url", ""),
        "peer_range_start_hash": fix_entry.get("range_start_hash", ""),
        "peer_fix_evidence_url": fix_entry.get("evidence_url", ""),
        "peer_fix_evidence_kind": fix_entry.get("evidence_kind", ""),
        "peer_fix_source": fix_entry.get("source", ""),
        "peer_fix_summary": fix_entry.get("summary", ""),
        "peer_fix_diff_excerpt": diff_excerpt[:6000],
    }


def build_s6_discovery_card(
    target_slug: str, peer: str, source_error: str = "",
) -> dict:
    """Keep one configured peer visible when feeds found no exact fix.

    A feed that raised and one that answered "nothing" both arrive here, and a
    degraded source is not an empty one. The card says which: the audit runs
    this generator with stderr discarded, so the card is the only place that
    difference survives to an operator or the agent working the lane.
    """
    silence = (
        f"source unavailable ({source_error})" if source_error
        else "produced no exact fix"
    )
    summary = (
        f"No exact VCS or fixed-range repair was available ({silence}). "
        "Resolve one exact security-relevant fix from official history before "
        "searching the target; close the card if none exists."
    )
    card = build_s6_card(
        target_slug, peer, {"source": "discovery", "summary": summary},
    )
    card["score"] = 20
    card["reason"] = (
        f"S6 peer discovery: {peer} {silence}; resolve one exact "
        "security-relevant fix from official history before mapping the target"
    )
    return card


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0] if __doc__ else "")
    workqueue.add_common_args(parser)
    parser.add_argument("--output", help="Output JSONL path; defaults to "
                        "<RESULTS_DIR>/s6-peer-cards.jsonl")
    parser.add_argument("--limit", type=int, default=40,
                        help="Max cards total (default 40)")
    parser.add_argument("--max-per-peer", type=int, default=6,
                        help="Max cards per peer (default 6)")
    parser.add_argument("--days", type=int, default=3650,
                        help="Look-back window in days (default 3650 ~ 10y). "
                        "Wide on purpose: OSV's `modified` timestamp for "
                        "OSS-Fuzz advisories reflects bulk-import bookkeeping, "
                        "not the fix date, so a narrow window silently drops "
                        "genuine peer fixes. Card volume is bounded by "
                        "--limit / --max-per-peer regardless.")
    parser.add_argument("--cache-ttl-days", type=int, default=7,
                        help="OSV cache TTL (default 7 days)")
    parser.add_argument("--peer-clone-roots", default="",
                        help="Colon-separated dirs to search for local peer "
                        "clones (preferred exact-fix source)")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args(argv)

    ctx = workqueue.context_from_args(args)
    output = Path(args.output).expanduser().resolve() if args.output \
        else ctx.results_dir / "s6-peer-cards.jsonl"

    # [s6_peers] is the only source of peers; run bin/suggest-peers to
    # populate it. A live audit reads its digest-pinned snapshot, the same
    # contract bin/probe uses, so a concurrent agent editing the shared
    # target.toml cannot change which peers this run mines. Standalone
    # generation has no session and keeps using the shared config.
    if (ctx.results_dir / ".session-env").is_file():
        try:
            target_toml = tc.target_toml_for_session_dir(ctx.results_dir)
        except tc.PinnedConfigError as e:
            print(f"[peer-fix-cards] pinned target.toml: {e}", file=sys.stderr)
            return 1
    else:
        target_toml = ROOT / "output" / ctx.target_slug / "target.toml"
    if not target_toml.is_file():
        print(f"[peer-fix-cards] target.toml not found: {target_toml}",
              file=sys.stderr)
        return 1
    cfg = tc.Config()
    cfg.slug = ctx.target_slug
    cfg.target_root = str(ctx.target_root)
    try:
        tc.load_toml_into(cfg, target_toml)
    except Exception as e:
        print(f"[peer-fix-cards] target.toml parse: {e}", file=sys.stderr)
        return 1

    if not cfg.s6_peers:
        if not args.quiet:
            print(f"[peer-fix-cards] no peers configured for {ctx.target_slug}; "
                  f"add [s6_peers] to {target_toml} or run "
                  f"bin/suggest-peers {ctx.target_slug}", file=sys.stderr)
        # Write empty JSONL so callers can rely on the file existing.
        workqueue.write_cards(output, [])
        return 0

    cache_dir = ctx.results_dir / ".s6-cache"
    clone_roots: list[Path] = []
    if args.peer_clone_roots:
        for raw in args.peer_clone_roots.split(":"):
            raw = raw.strip()
            if raw:
                clone_roots.append(Path(raw).expanduser())
    # Default search: targets/<peer-name>/, in case the operator clones
    # peers alongside the bundled targets.
    clone_roots.append(ROOT / "targets")

    # Round-robin below takes each peer's Nth card in turn, so only the first
    # `limit` peers can contribute one — the rest are not worth mining.
    peer_cards: list[list[dict]] = []
    seen_ids: set[str] = set()
    for peer in cfg.s6_peers[:args.limit]:
        source_error = ""
        source_errors: list[str] = []
        try:
            fixes = peer_sources.gather_peer_fixes(
                peer,
                cache_dir=cache_dir,
                cache_ttl_seconds=args.cache_ttl_days * 24 * 3600,
                days=args.days,
                peer_clone_search_roots=clone_roots,
                max_per_source=args.max_per_peer,
                source_errors=source_errors,
            )
            source_error = "; ".join(source_errors)[:120]
        except Exception as e:
            if not args.quiet:
                print(f"[peer-fix-cards] {peer}: source error: {e}",
                      file=sys.stderr)
            fixes = []
            source_error = str(e)[:120]

        # Interleave this peer's sources before the per-peer cap, the same way
        # peers are interleaved below. A local commit is exact but only
        # keyword-matched — build-warning and test cleanups pass that filter —
        # whereas an OSV entry is vulnerability-scoped by construction. Taking
        # the first N of a VCS-first list let six local commits hide every
        # advisory this peer has.
        by_source: dict[str, list[dict]] = {}
        for fix in fixes:
            by_source.setdefault(str(fix.get("source", "")), []).append(fix)
        fixes = [
            fix for row in zip_longest(*by_source.values())
            for fix in row if fix
        ]

        group: list[dict] = []
        clone = peer_sources.find_peer_clone(peer, clone_roots)
        for fix in fixes:
            if len(group) >= args.max_per_peer:
                break
            if not fix.get("fix_hash") and fix.get("source") == "ossfuzz":
                # Skip the tracker hint when we have nothing else — it's
                # useful as a pointer but not as a work card.
                continue

            # A mined VCS commit ships its exact diff. An OSV `fixed` event is
            # only a range endpoint. Prefer OSV's last-affected..first-fixed
            # diff, which contains the repair; fall back to the endpoint patch.
            # The prompt labels either excerpt so adjacent changes cannot
            # silently masquerade as the advertised fix.
            diff_excerpt = ""
            if fix.get("source") == "vcs" and clone is not None and fix.get("fix_hash"):
                diff_excerpt = peer_sources.fetch_fix_diff(clone, fix["fix_hash"])
            elif fix.get("source") == "osv" and fix.get("evidence_url"):
                diff_excerpt = peer_sources.fetch_patch_excerpt(
                    str(fix["evidence_url"]), cache_dir=cache_dir,
                    cache_ttl_seconds=args.cache_ttl_days * 24 * 3600,
                    summary=str(fix.get("summary", "")),
                )

            card = build_s6_card(ctx.target_slug, peer, fix, diff_excerpt)
            if card["id"] in seen_ids:
                continue
            seen_ids.add(card["id"])
            group.append(card)
        # An advisory range endpoint is a lead, not the repair. Keep one
        # bounded discovery route whenever the feeds supplied no exact VCS or
        # fixed-range diff; otherwise a noisy OSV feed can suppress the only
        # route to a reviewable fix and consume the whole S6 wall on history
        # searches. Retain endpoint leads behind it and stay within the
        # per-peer cap.
        has_exact_fix = any(
            card.get("peer_fix_source") == "vcs"
            or (
                card.get("peer_fix_evidence_kind") == "fixed-range"
                and card.get("peer_fix_diff_excerpt")
            )
            for card in group
        )
        if not has_exact_fix:
            group = [
                build_s6_discovery_card(ctx.target_slug, peer, source_error),
                *group,
            ]
        peer_cards.append(group[:args.max_per_peer])

    # Interleave peers so one noisy advisory feed cannot consume the review
    # gate before the agent sees another implementation of the same spec.
    cards = [
        card for row in zip_longest(*peer_cards) for card in row if card
    ][:args.limit]

    # Spend the finite lane on exact evidence, then bounded discovery, before
    # ambiguous advisory leads.
    def source_rank(card: dict) -> int:
        source = card.get("peer_fix_source")
        if source == "vcs":
            return 0
        if (
            source == "osv"
            and card.get("peer_fix_evidence_kind") == "fixed-range"
            and card.get("peer_fix_diff_excerpt")
        ):
            return 1
        if source == "discovery":
            return 2
        return 3

    cards.sort(key=source_rank)

    workqueue.write_cards(output, cards)
    if not args.quiet:
        print(f"[peer-fix-cards] wrote {len(cards)} S6 card(s) to {output}",
              file=sys.stderr)
        for card in cards:
            print(json.dumps(card, sort_keys=True))
    if not cards:
        # Configured peers that yield nothing are a degraded source, not an
        # empty one: OSV returns [] for a network failure exactly as it does
        # for "no advisories". Reporting success here let an unreachable
        # provider read downstream as a legitimate zero-yield campaign.
        print(f"[peer-fix-cards] no cards from configured peers "
              f"{', '.join(cfg.s6_peers)}; sources unreachable or empty",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
