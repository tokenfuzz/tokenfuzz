#!/usr/bin/env python3
"""Summarize non-noise libFuzzer artifacts for audit agents."""

from __future__ import annotations

import sys
from pathlib import Path

LIB_DIR = Path(__file__).resolve().parent.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

from fuzz_triage import DEFAULT_MAX_LEADS, TOOL, parse_limit, update_fuzz_leads


def main(argv: list[str]) -> int:
    results_arg = argv[0] if argv else ""
    if not results_arg or not Path(results_arg).is_dir():
        print(f"[{TOOL}] usage: {sys.argv[0]} <results_dir> [max_leads]", file=sys.stderr)
        return 2

    raw_limit = argv[1] if len(argv) > 1 else str(DEFAULT_MAX_LEADS)
    max_leads = parse_limit(raw_limit)
    if max_leads is None:
        print(f"[{TOOL}] max_leads must be a non-negative integer", file=sys.stderr)
        return 2

    returncode, message = update_fuzz_leads(results_arg, max_leads)
    if message:
        print(message, file=sys.stderr if returncode else sys.stdout)
    return returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
