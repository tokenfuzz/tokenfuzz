#!/usr/bin/env python3
"""Derive a native sanitizer CLI's testcase argv from its own help."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(os.environ["SCRIPT_ROOT"]).resolve() if os.environ.get("SCRIPT_ROOT") \
    else Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from llm_decide import llm_decide  # noqa: E402
from prompt_render import render_template  # noqa: E402
import runner_preflight  # noqa: E402
import target_config as tc  # noqa: E402

_MARKER = "# native CLI args set by bin/suggest-runner"
_PLACEHOLDERS = {"TESTCASE", "NULL_DEVICE"}
# A build tree holds more instrumented programs than the model needs to
# choose between, and each one costs a help probe. The manifest-declared
# CLIs lead the list, so the bound only truncates the long tail.
_MAX_CANDIDATES = 8
_HELP_IN_PROMPT = 2400
_HELP_TIMEOUT_SECONDS = 3
_MAX_SUGGESTIONS = 2


def read_help(binary: Path, env: dict | None = None, max_bytes: int = 16384) -> str:
    """Return the first useful bounded help response from a native CLI.

    Probed in a scratch directory on a closed stdin: a program that runs work
    instead of printing usage must not write into the caller's tree or consume
    the caller's input. One that does not answer within the deadline is left
    without help — it cannot be described to the model, and it is not a CLI
    whose help can be read."""
    for flag in ("--help", "-h"):
        with tempfile.TemporaryDirectory(prefix="suggest-runner-help-") as directory:
            try:
                completed, output = runner_preflight.capture_probe(
                    [str(binary), flag], _HELP_TIMEOUT_SECONDS, directory,
                    max_bytes, env,
                )
            except OSError:
                continue
            if completed.returncode == 124:
                return ""
            output = output.decode("utf-8", errors="replace")
            # A program that never reached main() has no argv to infer: its
            # loader diagnostic is long enough to pass for help text below.
            if runner_preflight.startup_failure_reason(
                completed.returncode, output
            ):
                return ""
            if len(output.strip()) >= 80:
                return output
    return ""


def candidate_programs(
    target: Path, sanitizer: str, configured: Path, env: dict | None = None,
) -> list[dict[str, str]]:
    """Selectable instrumented CLIs with their help, configured binary first.

    Programs that print no usable help are dropped: the model cannot derive
    an argv template from a program that does not describe itself. Both that
    and the candidate bound are reported, so a run never looks like it chose
    from more than it saw."""
    configured_real = os.path.realpath(configured)
    paths: list[Path] = []
    seen: set[str] = set()
    if tc.sanitizer_binary_is_usable(target, sanitizer, configured):
        paths.append(configured)
        seen.add(configured_real)
    else:
        print(
            f"[suggest-runner] configured binary is not an instrumented "
            f"{sanitizer} executable, not offered: {configured}",
            file=sys.stderr,
        )
    # Ask for one beyond the prompt bound so truncation is always visible,
    # including when the configured program is already in the detected set.
    for relative in tc.cli_candidates(target, sanitizer, _MAX_CANDIDATES + 1):
        resolved = target / relative
        if os.path.realpath(resolved) not in seen:
            seen.add(os.path.realpath(resolved))
            paths.append(resolved)
    for dropped in paths[_MAX_CANDIDATES:]:
        print(f"[suggest-runner] over the candidate bound, not offered: {dropped}",
              file=sys.stderr)
    programs: list[dict[str, str]] = []
    for path in paths[:_MAX_CANDIDATES]:
        help_text = read_help(path, env)
        if not help_text:
            print(f"[suggest-runner] no readable help, not offered: {path}",
                  file=sys.stderr)
            continue
        programs.append({
            "path": str(path).removeprefix(str(target) + "/"),
            "help": help_text,
            "configured": "1" if os.path.realpath(path) == configured_real else "",
        })
    for index, program in enumerate(programs, start=1):
        program["id"] = f"c{index}"
    return programs


def render_candidates(programs: list[dict[str, str]]) -> str:
    """Pre-render the candidate block; the template renderer has no loops."""
    blocks = []
    for program in programs:
        configured = "  (currently configured)" if program["configured"] else ""
        blocks.append(
            f"[{program['id']}] {program['path']}{configured}\n"
            f'help:\n"""\n{program["help"][:_HELP_IN_PROMPT]}\n"""'
        )
    return "\n\n".join(blocks)


def matching_sanitizer_bins(
    config: tc.Config, target: Path, selected: str, chosen: Path,
) -> dict[str, str]:
    """Validated same-program paths in every configured sanitizer build.

    Runner arguments are shared. Refuse to write them when another enabled
    native sanitizer would keep a different program: that would turn valid
    probes into misleading clean or non-executing runs.
    """
    configured = [
        sanitizer for sanitizer in config.sanitizers_enabled
        if config.sanitizer_bin(sanitizer)
    ]
    selected_build = target / tc.build_dir_name(selected)
    try:
        tail = chosen.relative_to(selected_build)
    except ValueError:
        if len(configured) > 1:
            raise ValueError(
                f"selected program is outside {selected_build}; cannot map "
                "shared runner arguments to the other sanitizer builds"
            )
        return {selected: str(chosen).removeprefix(str(target) + "/")}
    updates: dict[str, str] = {}
    for sanitizer in configured:
        candidate = target / tc.build_dir_name(sanitizer) / tail
        if tc.sanitizer_binary_is_usable(target, sanitizer, candidate):
            updates[sanitizer] = str(candidate).removeprefix(str(target) + "/")
        else:
            raise ValueError(
                f"matching instrumented {sanitizer} program is unavailable: "
                f"{candidate}"
            )
    return updates


def normalize_args(raw: object) -> list[str]:
    """Validate the bounded, shell-free argv template returned by the LLM."""
    if not isinstance(raw, list) or not 1 <= len(raw) <= 24:
        return []
    args: list[str] = []
    for value in raw:
        if (
            not isinstance(value, str) or not value or len(value) > 256
            or "\x00" in value or "\n" in value or "\r" in value
        ):
            return []
        if set(re.findall(r"\{([A-Z_]+)\}", value)) - _PLACEHOLDERS:
            return []
        args.append(value)
    if (
        args.count("{TESTCASE}") != 1
        or sum(value.count("{TESTCASE}") for value in args) != 1
    ):
        return []
    return args


def _assignment_end(lines: list[str], start: int, limit: int) -> int:
    """Return the end of a possibly multi-line TOML array assignment."""
    depth = 0
    quoted = escaped = False
    for index in range(start, limit):
        for char in lines[index]:
            if escaped:
                escaped = False
            elif char == "\\" and quoted:
                escaped = True
            elif char == '"':
                quoted = not quoted
            elif not quoted and char == "[":
                depth += 1
            elif not quoted and char == "]":
                depth -= 1
        if depth <= 0:
            return index + 1
    return limit


def set_runner_args(text: str, args: list[str], reasoning: str) -> str:
    """Set only [runner].args, preserving every other target setting."""
    lines = text.splitlines()
    rendered = "args = [" + ", ".join(tc.toml_basic_string(v) for v in args) + "]"
    comment = tc.toml_comment_lines(
        "native CLI args set by bin/suggest-runner — " + reasoning.strip()
    )
    section = next(
        (i for i, line in enumerate(lines) if line.strip() == "[runner]"), None
    )
    if section is None:
        if lines and lines[-1]:
            lines.append("")
        lines.extend(("[runner]", comment, rendered))
        return "\n".join(lines) + "\n"

    end = next(
        (i for i in range(section + 1, len(lines))
         if lines[i].lstrip().startswith("[")
         and not lines[i].lstrip().startswith("#")),
        len(lines),
    )
    assignment = next(
        (i for i in range(section + 1, end)
         if re.match(r"^\s*args\s*=", lines[i])),
        None,
    )
    if assignment is None:
        lines[end:end] = [comment, rendered]
    else:
        start = assignment - 1 if (
            assignment > section + 1 and lines[assignment - 1].startswith(_MARKER)
        ) else assignment
        finish = _assignment_end(lines, assignment, end)
        lines[start:finish] = [comment, rendered]
    return "\n".join(lines) + "\n"


def validate_launch(
    binary: Path, args: list[str], help_text: str, timeout: int,
    env: dict | None = None,
) -> tuple[bool, str]:
    """Reject unsafe launches and commands whose behavior ignores the input."""
    with tempfile.TemporaryDirectory(prefix="suggest-runner-") as directory:
        testcase = Path(directory) / "input.bin"
        missing = Path(directory) / "missing-input.bin"
        original = b"tokenfuzz invocation probe\n"
        testcase.write_bytes(original)

        def expand(path: Path) -> list[str]:
            return [
                value.replace("{TESTCASE}", str(path)).replace(
                    "{NULL_DEVICE}", os.devnull
                )
                for value in args
            ]

        try:
            completed, completed_output = runner_preflight.capture_probe(
                [str(binary), *expand(testcase)], 10, directory, 65536, env,
            )
        except OSError as exc:
            return False, str(exc)
        if completed.returncode == 124:
            return False, "derived invocation timed out after 10 seconds"
        try:
            unchanged = testcase.read_bytes() == original
        except OSError:
            unchanged = False
        if not unchanged:
            return False, "derived invocation modified or removed its testcase"
        created = [path.name for path in Path(directory).iterdir() if path != testcase]
        if created:
            return False, f"derived invocation created output: {created[0]}"
        # The check below concludes "it read the testcase" from the program
        # answering differently with and without one. That inference only holds
        # if the program answers the same way when nothing changed, so establish
        # that first, on the same input. A throughput benchmark is the case that
        # reached selection for real — it differs on every run, so it passed as
        # a reader on noise alone, and it was picked because it was the one
        # candidate whose help documented a file option.
        try:
            repeated, repeated_output = runner_preflight.capture_probe(
                [str(binary), *expand(testcase)], 10, directory, 65536, env,
            )
        except OSError as exc:
            return False, str(exc)
        if repeated.returncode == 124:
            return False, "derived invocation timed out after 10 seconds"
        if runner_preflight.probe_signature(
            completed, completed_output, testcase
        ) != runner_preflight.probe_signature(
            repeated, repeated_output, testcase
        ):
            return False, (
                "derived invocation did not behave the same way twice on one "
                "input, so nothing can be concluded from how it behaves without"
                " one"
            )
        try:
            absent, absent_output = runner_preflight.capture_probe(
                [str(binary), *expand(missing)], 10, directory, 65536, env,
            )
        except OSError as exc:
            return False, str(exc)
        if absent.returncode == 124:
            return False, "derived invocation timed out after 10 seconds"
        created = [path.name for path in Path(directory).iterdir() if path != testcase]
        if missing.exists():
            return False, "derived invocation treated the testcase path as output"
        if created:
            return False, f"derived invocation created output: {created[0]}"

        def signature(
            result: subprocess.CompletedProcess, output: bytes, path: Path,
        ) -> tuple[int, str]:
            rendered = output.decode("utf-8", errors="replace")
            normalized = rendered.replace(str(path), "{TESTCASE}")
            return result.returncode, normalized.replace(path.name, "{TESTCASE}")

        if (
            signature(completed, completed_output, testcase)
            == signature(absent, absent_output, missing)
        ):
            return False, "derived invocation did not depend on testcase contents or existence"
        if completed.returncode:
            prompt = render_template("validate_runner.md.j2", {
                "binary": str(binary),
                "args": repr(args),
                "returncode": str(completed.returncode),
                "output": (
                    completed_output[:8192].decode("utf-8", errors="replace")
                    or "(no diagnostic output)"
                ),
                "help": help_text,
            })
            decision = llm_decide(
                "runner-validate", "valid,reasoning", prompt, timeout,
            )
            if not decision or decision.get("valid") is not True:
                reason = (
                    str((decision or {}).get("reasoning") or "").strip()
                    or "nonzero launch did not prove the testcase was consumed as input"
                )
                return False, reason
    return True, ""


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("slug")
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--timeout", type=int, default=120)
    args = parser.parse_args(argv)

    target = ROOT / "targets" / args.slug
    target_toml = ROOT / "output" / args.slug / "target.toml"
    if not target_toml.is_file():
        print(f"[suggest-runner] target.toml not found: {target_toml}", file=sys.stderr)
        return 1
    cfg = tc.Config(target_root=str(target))
    tc.load_toml_into(cfg, target_toml)
    if cfg.runner_args and not args.force:
        return 4
    selected = cfg.first_executable_sanitizer()
    if selected is None:
        print("[suggest-runner] no executable sanitizer binary is configured", file=sys.stderr)
        return 1
    sanitizer, binary_name = selected
    binary = Path(binary_name)
    # Probe every candidate the way the sanitizer runner launches it: a target
    # that supplies its own library path in [runner].env would otherwise fail
    # in the loader here and look like a program with no readable help.
    environment = runner_preflight.runner_environment(cfg, sanitizer)
    programs = candidate_programs(target, sanitizer, binary, environment)
    if not programs:
        print(f"[suggest-runner] could not read help from {binary}", file=sys.stderr)
        return 1
    feedback = ""
    chosen: dict[str, str] | None = None
    runner_args: list[str] = []
    reasoning = ""
    chosen_binary = binary
    for attempt in range(1, _MAX_SUGGESTIONS + 1):
        prompt = render_template("suggest_runner.md.j2", {
            "slug": args.slug,
            "readme": tc.read_readme_excerpt(target) or "(no README found)",
            "candidates": render_candidates(programs),
            "feedback_block": feedback,
        })
        result = llm_decide(
            "runner-suggest", "binary,args,reasoning", prompt, args.timeout
        )
        if result is None:
            return 2
        chosen = next(
            (p for p in programs if p["id"] == str(result.get("binary", ""))),
            None,
        )
        runner_args = normalize_args(result.get("args"))
        reasoning = str(result.get("reasoning", "")).strip()
        if chosen is None:
            reason = f"candidate id {result.get('binary', '')!r} was not offered"
        elif not runner_args:
            reason = "argv template was invalid"
        else:
            chosen_binary = target / chosen["path"]
            valid, reason = validate_launch(
                chosen_binary, runner_args, chosen["help"], args.timeout,
                environment,
            )
            if valid:
                break
        if attempt == _MAX_SUGGESTIONS:
            print(f"[suggest-runner] refusing argv template: {reason}",
                  file=sys.stderr)
            return 3
        print(
            f"[suggest-runner] candidate rejected ({reason}); asking for revision",
            file=sys.stderr,
        )
        feedback = (
            "\nThe previous proposal was rejected by launch validation:\n"
            f"proposal = {result!r}\n"
            f"reason = {reason}\n"
            "Choose again from the same candidate ids and revise the argv.\n"
        )[:3000]
    assert chosen is not None

    current = target_toml.read_text(encoding="utf-8")
    candidate = set_runner_args(current, runner_args, reasoning)
    try:
        bin_updates = matching_sanitizer_bins(
            cfg, target, sanitizer, chosen_binary
        )
    except ValueError as exc:
        print(f"[suggest-runner] refusing shared runner arguments: {exc}",
              file=sys.stderr)
        return 3
    changed_bins: dict[str, str] = {}
    for update_sanitizer, update_path in bin_updates.items():
        configured_path = Path(
            cfg.resolve_path(cfg.sanitizer_bin(update_sanitizer))
        )
        update_binary = target / update_path
        if os.path.realpath(configured_path) == os.path.realpath(update_binary):
            continue
        candidate = tc.set_sanitizer_bin(
            candidate, update_sanitizer, update_path
        )
        changed_bins[update_sanitizer] = update_path
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", suffix=".toml",
        dir=target_toml.parent, delete=False,
    ) as stream:
        stream.write(candidate)
        temporary = Path(stream.name)
    temporary.chmod(target_toml.stat().st_mode & 0o777)
    try:
        parsed = tc.Config(target_root=str(target))
        tc.load_toml_into(parsed, temporary)
        parsed_binary = Path(
            parsed.resolve_path(parsed.sanitizer_bin(sanitizer))
        )
        if (
            os.path.realpath(parsed_binary) != os.path.realpath(chosen_binary)
            or parsed.runner_args != runner_args
        ):
            raise ValueError("validated binary/argv did not round-trip")
        for update_sanitizer, update_path in bin_updates.items():
            if os.path.realpath(
                parsed.resolve_path(parsed.sanitizer_bin(update_sanitizer))
            ) != os.path.realpath(target / update_path):
                raise ValueError(
                    f"validated {update_sanitizer}_bin did not round-trip"
                )
    except Exception as exc:
        temporary.unlink(missing_ok=True)
        print(f"[suggest-runner] refusing invalid target.toml: {exc}", file=sys.stderr)
        return 3
    if args.apply:
        os.replace(temporary, target_toml)
        print(f"[suggest-runner] configured native CLI argv in {target_toml}", file=sys.stderr)
    else:
        temporary.unlink(missing_ok=True)
        if "asan" in changed_bins:
            print(f"asan_bin = {tc.toml_basic_string(changed_bins['asan'])}")
        non_asan = [
            name for name in cfg.sanitizers_enabled
            if name != "asan" and name in changed_bins
        ]
        if non_asan:
            print("[sanitizer]")
            for name in non_asan:
                print(f"{name}_bin = {tc.toml_basic_string(changed_bins[name])}")
        print("[runner]")
        print("args = [" + ", ".join(tc.toml_basic_string(v) for v in runner_args) + "]")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
