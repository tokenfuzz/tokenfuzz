#!/usr/bin/env python3
"""Run ripgrep with audit-log exclusions and bounded stdout.

A capped search is a broad pattern, and the head and tail of its hit list
rarely tell the agent where the hits are. The cap therefore appends a
per-file hit digest from a second `rg --count` pass, so the next call can
narrow by path instead of paging through a spill file.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from file_tools import cap_output_file, capture_command
from command_tools import find_executable

# Audit transcripts showed the shared 50 KiB cap filling with grep noise that
# every later turn replays; 20 KiB still holds a few hundred match lines.
DEFAULT_CAP_BYTES = 20480
DIGEST_FILES = 30


def error(message: str) -> int:
    print(f"[rg-safe] {message}", file=sys.stderr)
    return 2


def real_rg() -> str | None:
    wrapper = Path(
        os.environ.get("AGENT_WRAPPERS_PATH", str(ROOT / "lib" / "wrappers"))
    ).resolve()
    return find_executable("rg", skip=(wrapper,))


def file_hit_digest(executable: str, argv: list[str]) -> bytes:
    """Per-file hit counts for a capped search, or b"" when rg cannot count."""
    import subprocess

    try:
        completed = subprocess.run(
            [executable, "--count", "--with-filename", "--no-messages", *argv],
            capture_output=True, text=True, errors="replace", timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired):
        return b""
    # Exit status 2 also covers one unreadable entry in an otherwise complete
    # count, so the count lines decide: a pattern error prints none.
    counts: list[tuple[int, str]] = []
    for line in completed.stdout.splitlines():
        path, separator, count = line.rpartition(":")
        if separator and count.isdigit() and path:
            counts.append((int(count), path))
    if not counts:
        return b""
    counts.sort(key=lambda item: (-item[0], item[1]))
    lines = [
        f"[rg-safe] {sum(count for count, _ in counts):,} matching lines in "
        f"{len(counts):,} files; hits per file, most first:"
    ]
    lines.extend(f"  {count:>6}  {path}" for count, path in counts[:DIGEST_FILES])
    if len(counts) > DIGEST_FILES:
        lines.append(f"  (+{len(counts) - DIGEST_FILES:,} more files)")
    lines.append(
        "[rg-safe] Narrow with a path, --glob, -w, or a tighter pattern; "
        "--cap-bytes=N or --no-cap widens."
    )
    return ("\n".join(lines) + "\n").encode()


def rooted_operands(stderr: bytes, args: list[str]) -> dict[str, str]:
    """Missing relative path operands that exist under the session's roots.

    Structured state names source target-relative (`src/parse.c`) while
    sessions run from the harness root, as `bin/peek` already allows for: 173
    of 175 relative operands rg reported missing across two opencv codex
    cells existed under TARGET_ROOT, each a wasted turn. rg names every
    missing operand verbatim, so which argv entries are paths is rg's own
    parse, never a guess about its flags. A spelling that appears more than
    once in argv may also be the pattern or an option value, so it is left
    alone.
    """
    roots = [
        Path(value)
        for value in (os.environ.get("TARGET_ROOT"), os.environ.get("RESULTS_DIR"))
        if value
    ]
    found: dict[str, str] = {}
    for line in stderr.decode(errors="replace").splitlines():
        if not (line.startswith("rg: ") and line.endswith("(os error 2)")):
            continue
        operand = line[len("rg: "):].split(": ", 1)[0]
        if args.count(operand) != 1 or Path(operand).is_absolute():
            continue
        for root in roots:
            if (root / operand).exists():
                found[operand] = str(root / operand)
                break
    return found


def run(
    executable: str, prefix: list[str], args: list[str], cap_env, *, reroot: bool,
) -> "tuple[int, bytes, bytes] | dict[str, str]":
    """Capped (returncode, stdout, stderr), or the operands to rerun rooted.

    The rerun is decided before capping, so a discarded first run leaves no
    spill file behind.
    """
    with capture_command([executable, *prefix, *args]) as completed:
        stderr = completed.stderr.read_bytes()
        rooted = rooted_operands(stderr, args) if reroot else {}
        if rooted:
            return rooted
        output = cap_output_file(completed.stdout, "rg-safe", cap_env)
        return completed.returncode, output, stderr


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    byte_value = os.environ.get("RG_BYTES")
    if byte_value is None and "OUTCAP_MAX_BYTES" not in os.environ:
        byte_value = str(DEFAULT_CAP_BYTES)
    include_logs = os.environ.get("RG_INCLUDE_LOGS", "0") == "1"
    passthrough: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in ("--no-cap", "--no-cap-bytes"):
            byte_value = "0"
        elif arg == "--cap-bytes":
            if index + 1 >= len(args):
                return error("--cap-bytes needs a value")
            index += 1
            byte_value = args[index]
        elif arg.startswith("--cap-bytes="):
            byte_value = arg.split("=", 1)[1]
        elif arg == "--include-logs":
            include_logs = True
        elif arg == "--":
            passthrough.extend(args[index:])
            break
        else:
            passthrough.append(arg)
        index += 1

    if byte_value is not None and not byte_value.isdigit():
        return error(f"non-numeric --cap-bytes: {byte_value}")
    executable = real_rg()
    if not executable:
        return error("rg (ripgrep) not found in PATH")

    prefix = ["--glob", "!**/.git/**", "--glob", "!**/.hg/**"]
    if not include_logs:
        prefix.extend(("--glob", "!**/output/**/logs/**"))
    cap_env = None
    if byte_value is not None:
        byte_cap = int(byte_value)
        cap_env = dict(os.environ)
        cap_env["OUTCAP_MAX_BYTES"] = str(byte_cap)
        cap_env["OUTCAP_HEAD_BYTES"] = str(byte_cap * 3 // 5)
        cap_env["OUTCAP_TAIL_BYTES"] = str(byte_cap * 2 // 5)
    try:
        result = run(executable, prefix, passthrough, cap_env, reroot=True)
        if isinstance(result, dict):
            passthrough = [result.get(arg, arg) for arg in passthrough]
            result = run(executable, prefix, passthrough, cap_env, reroot=False)
        returncode, output, stderr = result
    except ValueError as exc:
        print(exc, file=sys.stderr)
        return 2
    sys.stderr.buffer.write(stderr)
    sys.stderr.buffer.flush()
    sys.stdout.buffer.write(output)
    if b"[output_cap: rg-safe truncated" in output:
        sys.stdout.buffer.write(file_hit_digest(executable, [*prefix, *passthrough]))
    return returncode


if __name__ == "__main__":
    raise SystemExit(main())
