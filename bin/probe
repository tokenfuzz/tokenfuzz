from probe_helpers import _nonnegative_int
from timeout import run_timeout

VALID_MODES = {"auto", "browser", "js", "generic"}
VALID_SANITIZERS = {"asan", "ubsan", "msan", "tsan", "race", "runner"}
MODE_MATRIX = {
    "asan": {"browser", "js", "generic"},
    "ubsan": {"browser", "js", "generic"},
    "msan": {"js", "generic"},
    "tsan": {"js", "generic"},
    "race": {"generic"},
    "runner": {"generic"},
}
COMPILE_SANITIZERS = {"asan": "address", "ubsan": "undefined", "msan": "memory", "tsan": "thread"}
SCRIPT_EXTENSIONS = {"js", "mjs", "cjs", "ts", "tsx", "jsx", "py", "rb", "php", "pl", "pm", "r", "sh", "bash", "zsh", "kts"}
HEADER_RE = {
    "target": re.compile(r"^[^A-Za-z]*TARGET:\s*(.+?)\s*(?:-->|\*/)?\s*$", re.M),
    "hypothesis": re.compile(r"HYPOTHESIS-ID:\s*([^\s>*]+)"),
    "card": re.compile(r"CARD-ID:\s*([^\s>*]+)"),
    "mode": re.compile(r"^[^A-Za-z]*MODE:\s*([A-Za-z0-9_-]+)", re.M),
    "harness": re.compile(r"^[^A-Za-z]*HARNESS:\s*([^\s>*]+)", re.M),
    "property": re.compile(r"^[^A-Za-z]*PROPERTY:\s*([A-Za-z0-9_-]+)", re.M),
}
S8_PROPERTY_KINDS = {
    "inverse", "idempotence", "injectivity", "domain", "format", "equivalence",
}
BARE_METADATA = re.compile(r"^\s*(TARGET|HYPOTHESIS-ID|CARD-ID|CATEGORY|MODE|HARNESS|PROPERTY):\s*")
# A setter names the variable and supplies the library as a later argument.
_LOADER_SETTER_RE = re.compile(
    r"\b(?:setenv|_putenv_s|SetEnvironmentVariable(?:A|W)?)\s*\(\s*"
    r'"(?:DYLD_INSERT_LIBRARIES|LD_PRELOAD)"\s*,'
    r'(?!\s*(?:""\s*[,)]|(?:NULL|nullptr)\b|0\s*[,)]))'
)
# Everything else carries both halves in one literal, wherever it sits:
# putenv, an execve / posix_spawn environment array, or a command string. A
# closing quote means the value is empty and a format specifier means the
# literal is a message, so neither supplies a library.
_LOADER_ASSIGNMENT_RE = re.compile(
    r'"(?:DYLD_INSERT_LIBRARIES|LD_PRELOAD)=(?!["%])'
)
_PROCESS_LAUNCH_RE = re.compile(
    r"(?<![A-Za-z0-9_.>:])(?:(?:::|std\s*::)\s*)?(?:"
    r"exec(?:l|le|lp|v|ve|vp|vpe)|posix_spawnp?|system|popen|_popen|"
    r"_spawn(?:l|le|lp|lpe|v|ve|vp|vpe)|CreateProcess(?:A|W)?|"
    r"ShellExecute(?:Ex)?(?:A|W)?|WinExec"
    r")\s*\("
)
# Sanitizers name the faulting module beside the offset, in every report format
# that could not resolve a source line: `(<module>[:<arch>]+0x<offset>)`.
_SANITIZER_MODULE_RE = re.compile(
    r"\(([^()\s]+?)(?::[A-Za-z0-9_]+)?\+0x[0-9a-f]+\)"
)
_SOURCE_LOCATION_RE = re.compile(r"^(?P<path>.+?):\d+(?::\d+)?$")
_C_LINE_SPLICE_RE = re.compile(r"\\(?:\r\n|\n|\r)")
_C_LEXEME_RE = re.compile(
    r'(?P<raw>(?:u8|[uUL])?R"(?P<raw_delimiter>[^ ()\\\t\r\n]{0,16})'
    r'\(.*?\)(?P=raw_delimiter)")|(?P<string>(?:u8|[uUL])?"(?:\\.|[^"\\])*")|'
    r"(?P<char>(?:u8|[uUL])?'(?:\\.|[^'\\])*')|"
    r"(?P<comment>//[^\n]*|/\*.*?(?:\*/|\Z))",
    re.S,
)
_LOADER_STRING_RE = re.compile(
    r'^"(?:DYLD_INSERT_LIBRARIES|LD_PRELOAD)(?:=[^"]*)?"$'
)
_EMPTY_STRING_RE = re.compile(r'^(?:u8|[uUL])?""$')
_VERIFIED_NONZERO_RUNNER_RE = re.compile(
    r"^\[run-(?:asan|ubsan|msan|tsan)\] generic EXECUTION VERIFIED "
    r"\(post-run, rc=[1-9][0-9]*\)$",
    re.MULTILINE,
)
HELP = """Usage:
  bin/probe [--confirm | --sanitizer-runs N] [--dry-run] [--mode auto|browser|js|generic] \\
            [--hypothesis-id HYPOTHESIS-ID] [--harness NAME] [--property KIND] \\
            [--want REGEX] testcase [-- harness-args...]

Required testcase headers:
  TARGET: <file[:function[:line]]>
  HYPOTHESIS-ID: H<n>
  CATEGORY: bounds|lifetime|type|size|uninit|state

Optional testcase headers:
  MODE: auto|browser|js|generic
  HARNESS: harness.c
  CARD-ID: <id>
  PROPERTY: inverse|idempotence|injectivity|domain|format|equivalence (required for S8)

For opaque byte inputs that cannot carry comments, pass --hypothesis-id;
TARGET and CARD-ID are derived from that hypothesis in structured state.
--harness supplies the HARNESS header the same way, for a fuzz artifact
replayed against the harness that produced it.
--property supplies the required PROPERTY header for an opaque S8 input.

PROBE_SANITIZER=asan|ubsan|msan|tsan|race|runner overrides target.toml.
--confirm runs five times; --sanitizer-runs runs an explicit positive count;
--dry-run resolves and prints the command only.
"""


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(add_help=False, usage=argparse.SUPPRESS)
    parser.add_argument("--mode", default="auto")
    runs = parser.add_mutually_exclusive_group()
    runs.add_argument("--confirm", action="store_true")
    runs.add_argument("--sanitizer-runs", type=int)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--want", default="")
    parser.add_argument("--hypothesis-id", default="")
    # An opaque byte input cannot carry a header, so fields a testcase
    # would otherwise declare in one arrive as flags instead. Same resolution
    # rules apply either way: the name stays relative to the testcase's own
    # directory.
    parser.add_argument("--harness", default="")
    parser.add_argument("--property", default="")
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("testcase", nargs="?")
    parser.add_argument("args", nargs=argparse.REMAINDER)
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        print(HELP, file=sys.stderr)
        raise
    if args.help:
        print(HELP)
        raise SystemExit(0)
    if not args.testcase:
        print(HELP, file=sys.stderr)
        raise SystemExit(2)
    if args.mode not in VALID_MODES:
        raise ValueError(f"invalid mode: {args.mode}")
    if args.sanitizer_runs is not None and args.sanitizer_runs < 1:
        raise ValueError("--sanitizer-runs must be a positive integer")
    if args.want == "auto":
        args.want = ""
    if args.args and args.args[0] == "--":
        args.args.pop(0)
    return args


def sanitizer_run_count(args: argparse.Namespace, environment: Mapping[str, str]) -> int:
    if args.sanitizer_runs is not None:
        return args.sanitizer_runs
    if args.confirm:
        return 5
    try:
        return max(1, int(environment.get("SANITIZER_RUNS", "1")))
    except ValueError:
        return 1


def path_under(root: Path, path: Path) -> bool:
    try:
        return os.path.commonpath((root.resolve(), path.resolve())) == str(root.resolve())
    except ValueError:
        return False


def load_config(testcase: Path) -> target_config.Config:
    try:
        cfg = target_config.load(testcase)
    except (FileNotFoundError, ValueError):
        results = os.environ.get("RESULTS_DIR", "")
        target_root = os.environ.get("TARGET_ROOT", "")
        if not results or not target_root:
            raise RuntimeError(
                f"could not locate output/<slug>/<backend>/results/.session-env above {testcase}; "
                "run `bin/audit --target <slug>` first"
            )
        cfg = target_config.Config(
            results_dir=results,
            target_root=target_root,
            slug=os.environ.get("TARGET_SLUG", ""),
            target_rev=os.environ.get("TARGET_REV", ""),
            logdir=os.environ.get("LOGDIR", ""),
        )
        toml_path = Path(results).resolve().parent.parent / "target.toml"
        if toml_path.is_file():
            target_config.load_toml_into(cfg, toml_path)
        elif not cfg.sanitizers_enabled:
            cfg.sanitizers_enabled.append("asan")
    overrides = {
        "asan_bin": "TARGET_ASAN_BIN", "asan_lib": "TARGET_ASAN_LIB",
        "ubsan_bin": "TARGET_UBSAN_BIN", "ubsan_lib": "TARGET_UBSAN_LIB",
        "msan_bin": "TARGET_MSAN_BIN", "msan_lib": "TARGET_MSAN_LIB",
        "tsan_bin": "TARGET_TSAN_BIN", "tsan_lib": "TARGET_TSAN_LIB",
        "runner_bin": "TARGET_RUNNER_BIN",
    }
    for attribute, variable in overrides.items():
        if variable in os.environ:
            setattr(cfg, attribute, os.environ[variable])
    return cfg


def parse_header(testcase: Path) -> dict[str, str]:
    with testcase.open("rb") as stream:
        data = stream.read(16384)
    text = "".join(chr(byte) for byte in data if byte in (9, 10) or 32 <= byte <= 126)
    text = "\n".join(text.splitlines()[:16])
    result: dict[str, str] = {}
    for name, pattern in HEADER_RE.items():
        match = pattern.search(text)
        result[name] = match.group(1).strip() if match else ""
    return result


def validate_s8_property(strategy: str, property_kind: str) -> None:
    if strategies.normalize(strategy) != "S8":
        return
    normalized = property_kind.strip().lower()
    if normalized not in S8_PROPERTY_KINDS:
        allowed = "|".join(sorted(S8_PROPERTY_KINDS))
        raise ValueError(f"S8 testcase requires PROPERTY: {allowed}")


def file_has_property_violation(path: Path, returncode: int) -> bool:
    """Require both the oracle marker and its raw nonzero child exit."""
    marker = False
    failed = returncode != 0
    try:
        with path.open(encoding="utf-8", errors="replace") as stream:
            for line in stream:
                marker = marker or line.startswith("PROPERTY VIOLATION:")
                failed = failed or bool(_VERIFIED_NONZERO_RUNNER_RE.match(line.rstrip("\n")))
                if marker and failed:
                    return True
    except OSError:
        pass
    return False


def derive_want(target: str) -> str:
    if ":" in target:
        without_line = target.rsplit(":", 1)[0]
        _, separator, function = without_line.partition(":")
        if separator and function:
            return re.escape(function)
    filename = Path(target.split(":", 1)[0]).name
    return re.escape(filename)


def feature_disabled_marker(path: Path) -> str:
    overlap = ""
    try:
        with path.open(encoding="utf-8", errors="replace") as stream:
            while chunk := stream.read(64 * 1024):
                text = overlap + chunk
                if match := build_routes.FEATURE_DISABLED_RE.search(text):
                    return match.group(0)
                overlap = text[-4096:]
    except OSError:
        pass
    return ""


def prepare_exec_testcase(testcase: Path, config: target_config.Config, agent: str) -> Path:
    extension = testcase.suffix.lstrip(".")
    if extension not in SCRIPT_EXTENSIONS:
        return testcase
    with testcase.open(errors="replace") as stream:
        header_lines = [stream.readline() for _ in range(16)]
    if not any(BARE_METADATA.match(line) for line in header_lines):
        return testcase
    digest_hash = hashlib.sha1()
    with testcase.open("rb") as stream:
        while chunk := stream.read(1024 * 1024):
            digest_hash.update(chunk)
    digest = digest_hash.hexdigest()
    destination_dir = Path(config.results_dir) / f"scratch-{agent}" / ".probe-exec"
    destination_dir.mkdir(parents=True, exist_ok=True)
    destination = destination_dir / f"{testcase.stem}.{digest}.exec.{extension}"
    with testcase.open(errors="replace") as source, destination.open("w") as output:
        for index, line in enumerate(source):
            if index == 0 and line.startswith("#!"):
                output.write(line)
            elif not BARE_METADATA.match(line):
                output.write(line)
    destination.chmod(testcase.stat().st_mode & 0o777)
    return destination


def resolve_executable(value: str, config: target_config.Config) -> str:
    return shutil.which(value) or (value if os.access(value, os.X_OK) else config.resolve_path(value))


def stat_key(path: str) -> str:
    try:
        stat = Path(path).stat()
        return f"{int(stat.st_mtime)}:{stat.st_size}"
    except OSError:
        return ""


def _c_carrier_tokens(text: str) -> str:
    """Keep only carrier-relevant C tokens after translation-phase splicing."""
    text = _C_LINE_SPLICE_RE.sub("", text)

    def mask(match: re.Match[str]) -> str:
        string = match.group("string")
        if string is not None and _LOADER_STRING_RE.fullmatch(string):
            return string
        if string is not None:
            return '""' if _EMPTY_STRING_RE.fullmatch(string) else '"?"'
        value = match.group(0)
        return "".join("\n" if char == "\n" else " " for char in value)

    return _C_LEXEME_RE.sub(mask, text)


def reject_harness_only_carrier(source: Path) -> None:
    """Reject compiled wrappers that conclusively manufacture a target boundary.

    Ordinary launchers can still carry real file/protocol inputs, so ambiguous
    cases stay for provenance review. Loader injection has no testcase-derived
    target state and is safe to stop before confirmation.

    Only an assignment that supplies a library is injection, so reading or
    clearing the variable stays allowed. Interpreted harnesses and carriers that
    build the assignment at runtime are out of scope here and reach the same
    boundary through provenance review.
    """
    code = _c_carrier_tokens(source.read_text(encoding="utf-8", errors="replace"))
    if not _PROCESS_LAUNCH_RE.search(code):
        return
    interposition = _LOADER_SETTER_RE.search(code) or _LOADER_ASSIGNMENT_RE.search(code)
    if not interposition:
        return
    raise ValueError(
        f"HARNESS uses dynamic-loader interposition "
        f"({interposition.group(0).strip()}): {source}; "
        "HARNESS code must reach the target through its public API, CLI input, "
        "or protocol, not injected code or state. Run a CLI testcase through "
        "bin/probe, or derive the API call and state from the testcase/public "
        "protocol boundary."
    )


def _results_scratch_path(path: str, results_dir: str) -> Path | None:
    """Return an absolute path only when it is below RESULTS_DIR/scratch-N."""
    candidate = Path(path)
    if not candidate.is_absolute() or not results_dir:
        return None
    try:
        absolute = Path(os.path.abspath(candidate))
        results = Path(os.path.abspath(results_dir))
        resolved = absolute.resolve(strict=False)
        roots = (results, results.resolve(strict=False))
    except (OSError, RuntimeError):
        return None
    for form in dict.fromkeys((absolute, resolved)):
        for root in dict.fromkeys(roots):
            try:
                relative = form.relative_to(root)
            except ValueError:
                continue
            if relative.parts and re.fullmatch(r"scratch-[0-9]+", relative.parts[0]):
                return resolved
    return None


def foreign_crash_images(
    sanitizer_output: str, ran_binary: str, results_dir: str,
) -> list[str]:
    """Scratch-built modules in the report that are not the binary probe ran.

    A HARNESS can hand control to a binary the agent compiled itself — through
    `exec`, a spawned child, or anything else source inspection would have to
    chase through aliases, macros, and scopes. The sanitizer settles it after
    the fact: it names the module a fault came from, and a module under the
    agent's scratch tree that probe did not build is a diagnostic about a
    binary no bundle can ship.

    Only an absolute module below this run's results scratch tree decides. The
    target's own build and system libraries are where legitimate wrappers and
    ordinary drivers crash, and similarly named paths outside RESULTS_DIR are
    unrelated — all of those fall open.
    """
    if not ran_binary:
        # Nothing to compare against: a target with neither a harness nor a
        # configured runner leaves the binary unset, and treating every scratch
        # module as foreign there would discard the crash it just proved.
        return []
    try:
        ran = Path(ran_binary).resolve(strict=False)
    except (OSError, RuntimeError):
        return []
    foreign = []
    for module in dict.fromkeys(_SANITIZER_MODULE_RE.findall(sanitizer_output)):
        resolved = _results_scratch_path(module, results_dir)
        if (
            resolved is not None
            and resolved != ran
        ):
            foreign.append(module)
    return foreign


def foreign_crash_main_sources(
    sanitizer_output: str, harness_source: Path | None, results_dir: str,
) -> list[str]:
    """Absolute scratch sources for another process's ``main`` frame.

    A fully symbolized report can put the fault in a system library and name
    the separately built carrier only in a lower ``main`` frame.  Absolute
    source paths are unambiguous, so compare them with the exact harness source
    probe compiled.  Bare source names deliberately fall open: resolving a
    ``main.c`` basename against scratch is what rejected target files that
    happened to share the name.
    """
    try:
        harness = harness_source.resolve(strict=False) if harness_source else None
    except (OSError, RuntimeError):
        harness = None
    foreign = []
    for line in sanitizer_output.splitlines():
        frame = stack_frames.parse_asan_frame(line)
        if frame is None or not re.match(r"^main(?:\(|$)", frame.function):
            continue
        match = _SOURCE_LOCATION_RE.match(frame.location)
        if match is None:
            continue
        source = _results_scratch_path(match.group("path"), results_dir)
        if (
            source is not None
            and source != harness
        ):
            foreign.append(str(source))
    return list(dict.fromkeys(foreign))


class HarnessBuilder:
    def __init__(self, probe: "Probe", source: Path):
        self.probe = probe
        self.source = source
        self.dispatch = languages.probe_dispatch(source.suffix)
        if self.dispatch is None:
            raise ValueError(f"HARNESS source has unsupported extension: {source}")
        if self.dispatch["build_kind"] == "cc":
            reject_harness_only_carrier(source)

    def build(self) -> tuple[str, list[str], str]:
        kind = self.dispatch["build_kind"]
        if kind == "interpret":
            override = os.environ.get(self.dispatch["interpreter_env"], "")
            binary = override or self.dispatch["interpreter_default"]
            return binary, [*self.dispatch["interpreter_preargs"], str(self.source)], kind
        compiler = os.environ.get(self.dispatch["compiler_env"], "") or self.dispatch["compiler_default"]
        flags = shlex.split(os.environ.get(self.dispatch["flags_env"], ""))
        resolved_links = self.probe.config.resolved_link_libs()
        cache = Path(self.probe.config.results_dir) / f"scratch-{self.probe.agent}" / ".harness-cache"
        cache.mkdir(parents=True, exist_ok=True)
        sanitizer_lib = self._sanitizer_lib() if kind == "cc" else ""
        identity = "\n".join((
            "schema=5", f"source={hashlib.sha1(self.source.read_bytes()).hexdigest()}",
            f"compiler={shutil.which(compiler) or compiler}", f"compiler_stat={stat_key(shutil.which(compiler) or compiler)}",
            f"kind={kind}", f"flags={flags}", f"sanitizer={self.probe.sanitizer}",
            f"library={sanitizer_lib}", f"library_stat={stat_key(sanitizer_lib)}",
            f"includes={self.probe.config.includes}", f"defines={self.probe.config.defines}",
            f"links={resolved_links}", f"ldflags={os.environ.get('LDFLAGS', '')}",
            f"target_rev={self.probe.config.target_rev}",
        ))
        digest = hashlib.sha1(identity.encode()).hexdigest()
        binary = cache / f"{self.source.name}.{digest}.bin"
        failed_log = cache / f"{self.source.name}.{digest}.build.log"
        lock = cache / f"{self.source.name}.{digest}.lock"
        if os.access(binary, os.X_OK):
            return str(binary), [], kind
        if failed_log.is_file() and failed_log.stat().st_size:
            self._show_failure(failed_log, cached=True)
        self._acquire(lock, binary, failed_log)
        try:
            if os.access(binary, os.X_OK):
                return str(binary), [], kind
            if failed_log.is_file() and failed_log.stat().st_size:
                self._show_failure(failed_log)
            if kind == "rust":
                completed = self._build_rust(binary)
            else:
                command = self._command(kind, compiler, flags, binary, sanitizer_lib)
                completed = subprocess.run(
                    command, capture_output=True, check=False,
                    cwd=self.probe.config.target_root if kind == "go" else None,
                )
            if completed.returncode:
                failed_log.write_bytes(completed.stderr + completed.stdout)
                binary.unlink(missing_ok=True)
                self._show_failure(failed_log)
            failed_log.unlink(missing_ok=True)
            print(f"[probe] built harness: {binary}")
            return str(binary), [], kind
        finally:
            (lock / "owner").unlink(missing_ok=True)
            try:
                lock.rmdir()
            except OSError:
                pass

    def _build_rust(self, binary: Path) -> subprocess.CompletedProcess:
        """Build one direct Rust testcase against the audited crate.

        A library-only crate has no ``cargo run`` route, so the testcase gets a
        detached package that path-depends on the audited crate. Release mode
        matches the bootstrap build: `debug_assert!` and overflow checks fire on
        conditions a shipped build does not have.
        """
        manifest = Path(self.probe.config.target_root) / "Cargo.toml"
        try:
            raw = target_config.parse_toml(manifest)
            package = raw["package"]
            package_name = str(package["name"])
        except (OSError, ValueError, KeyError, TypeError) as exc:
            raise ValueError(
                f"Rust testcases need a root Cargo package in {manifest}: {exc}"
            ) from exc
        library = raw.get("lib", {})
        crate_name = str(library.get("name") or package_name.replace("-", "_"))
        project = binary.with_suffix(".cargo")
        project.mkdir(parents=True, exist_ok=True)
        harness_name = f"tokenfuzz_harness_{hashlib.sha1(str(binary).encode()).hexdigest()[:12]}"
        harness_manifest = project / "Cargo.toml"
        quote = target_config.toml_basic_string
        dependencies = [
            f"{quote(crate_name)} = {{ package = {quote(package_name)}, "
            f"path = {quote(self.probe.config.target_root)} }}"
        ]
        dev_dependencies = raw.get("dev-dependencies", {})
        if isinstance(dev_dependencies, dict) and dev_dependencies:
            named = self._rust_named_crates()
            for name, spec in dev_dependencies.items():
                # Carry only what this testcase names. Cargo builds a normal
                # dependency whether or not it is used, so an unused one that
                # needs a network fetch, a system library, or a build script
                # this host cannot run would fail every probe against a crate
                # whose own library builds fine.
                if named is not None and str(name).replace("-", "_") not in named:
                    continue
                rendered = self._cargo_dependency(str(name), spec, raw, package_name)
                if rendered is not None:
                    dependencies.append(f"{quote(str(name))} = {rendered}")
        harness_manifest.write_text(
            "[package]\n"
            f"name = {quote(harness_name)}\n"
            'version = "0.0.0"\n'
            'edition = "2021"\n\n'
            "[dependencies]\n"
            + "\n".join(dependencies) + "\n\n"
            "[[bin]]\n"
            f"name = {quote(harness_name)}\n"
            f"path = {quote(str(self.source))}\n",
            encoding="utf-8",
        )
        # One target directory for the whole cache: every testcase shares the
        # audited crate's compiled dependencies instead of rebuilding them.
        target_dir = binary.parent / "rust-target"
        command = [
            "cargo", "build", "--quiet", "--release",
            "--manifest-path", str(harness_manifest),
            "--target-dir", str(target_dir),
        ]
        completed = subprocess.run(
            command, capture_output=True, check=False,
            env=runner_preflight.runner_environment(
                self.probe.config, self.probe.sanitizer,
            ),
        )
        if completed.returncode == 0:
            built = target_dir / "release" / (
                harness_name + (".exe" if os.name == "nt" else "")
            )
            shutil.copy2(built, binary)
            binary.chmod(binary.stat().st_mode | 0o111)
        return completed

    def _rust_named_crates(self) -> "set[str] | None":
        """Crate identifiers the testcase names, or None when it cannot be read.

        A Rust testcase must name every crate it uses — `use x`, `extern crate
        x`, or a `x::` path — so this is the set of dev-dependencies it could
        possibly need. Unreadable source carries them all, as before.
        """
        try:
            text = self.source.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return None
        named = set(re.findall(r"\b(?:use|extern\s+crate)\s+([A-Za-z_]\w*)", text))
        named.update(re.findall(r"\b([A-Za-z_]\w*)\s*::", text))
        return named

    def _cargo_dependency(
        self, name: str, value: object, manifest: dict, package_name: str,
    ) -> str | None:
        """Render one parsed dev-dependency, or None when it cannot be carried.

        Dev-dependencies are a convenience for public-API testcases, not the
        route to the audited crate, which is always the path dependency above.
        A shape this cannot resolve — an external workspace, a self-reference
        that would pull the published crate instead of the checkout — is
        dropped, and `rustc` names it if the testcase actually needed it.
        """
        resolved = str(value.get("package", name)) if isinstance(value, dict) else name
        if resolved == package_name:
            return None
        if isinstance(value, dict) and value.get("workspace") is True:
            workspace = manifest.get("workspace", {})
            shared = workspace.get("dependencies", {}) if isinstance(workspace, dict) else {}
            inherited = shared.get(name)
            if inherited is None and value.get("package"):
                inherited = shared.get(str(value["package"]))
            if inherited is None:
                return None
            base = dict(inherited) if isinstance(inherited, dict) else {"version": inherited}
            local = {k: v for k, v in value.items() if k != "workspace"}
            # Cargo adds an inheriting member's features to the workspace's.
            features = list(base.get("features", [])) + list(local.pop("features", []))
            base.update(local)
            if features:
                base["features"] = list(dict.fromkeys(features))
            value = base
        if isinstance(value, dict):
            value = dict(value)
            path = value.get("path")
            if isinstance(path, str):
                value["path"] = str(
                    (Path(self.probe.config.target_root) / path).resolve()
                )
        try:
            return self._toml_value(value)
        except ValueError:
            return None

    @classmethod
    def _toml_value(cls, value: object) -> str:
        if isinstance(value, str):
            return target_config.toml_basic_string(value)
        if isinstance(value, bool):
            return "true" if value else "false"
        if isinstance(value, (int, float)):
            return str(value)
        if isinstance(value, list):
            return "[" + ", ".join(cls._toml_value(item) for item in value) + "]"
        if isinstance(value, dict):
            return "{ " + ", ".join(
                f"{target_config.toml_basic_string(str(key))} = {cls._toml_value(item)}"
                for key, item in value.items()
            ) + " }"
        raise ValueError(f"unsupported Cargo dependency value: {value!r}")

    def _sanitizer_lib(self) -> str:
        raw = self.probe.config.sanitizer_lib(self.probe.sanitizer)
        library = self.probe.config.resolve_path(raw) if raw else ""
        if not library:
            if os.environ.get("PROBE_REQUIRE_SANITIZER_LIB") == "1":
                raise ValueError(
                    f"target.toml {self.probe.sanitizer}_lib missing"
                )
            # Header-only targets link nothing, so this is not an error. Say
            # so anyway: an undefined-symbol failure that follows a dropped
            # <san>_lib otherwise reads as a defect in the testcase.
            print(
                f"[probe] no target.toml {self.probe.sanitizer}_lib; linking "
                "the harness against includes and link_libs only",
                file=sys.stderr,
            )
            return ""
        if library and not Path(library).is_file():
            if self.probe.sanitizer == "asan" or os.environ.get("PROBE_REQUIRE_SANITIZER_LIB") == "1":
                raise ValueError(f"target.toml {self.probe.sanitizer}_lib missing: {library}")
            print(
                f"[probe] WARN: target.toml {self.probe.sanitizer}_lib missing ({library}); "
                f"building with -fsanitize={COMPILE_SANITIZERS[self.probe.sanitizer]} only",
                file=sys.stderr,
            )
            return ""
        return library

    def _command(self, kind: str, compiler: str, flags: list[str], binary: Path, library: str) -> list[str]:
        if kind == "cc":
            sanitizer_flag = COMPILE_SANITIZERS.get(self.probe.sanitizer)
            if not sanitizer_flag:
                raise ValueError(f"compiled C/C++ HARNESS does not support sanitizer: {self.probe.sanitizer}")
            includes = [value for path in self.probe.config.includes for value in ("-I", self.probe.config.resolve_path(path))]
            library_args = [library] if library else []
            if library and Path(library).parent != Path("."):
                library_args.append(f"-Wl,-rpath,{Path(library).parent}")
            return [
                compiler, f"-fsanitize={sanitizer_flag}", "-g1", "-O0", *flags,
                *self.probe.config.defines, *includes, str(self.source), *library_args,
                *self.probe.config.resolved_link_libs(),
                *shlex.split(os.environ.get("LDFLAGS", "")), "-o", str(binary),
            ]
        if kind == "go":
            return [compiler, "build", "-o", str(binary), *flags, str(self.source)]
        if kind == "swift":
            return [compiler, "-gline-tables-only", "-O0", *flags, "-o", str(binary), str(self.source)]
        if kind == "kotlin":
            jar = Path(str(binary) + ".jar")
            command = [compiler, *flags, str(self.source), "-include-runtime", "-d", str(jar)]
            completed = subprocess.run(command, capture_output=True, check=False)
            if completed.returncode:
                raise subprocess.CalledProcessError(completed.returncode, command, completed.stdout, completed.stderr)
            binary.write_text(
                "#!/usr/bin/env python3\nimport os,sys\nos.execvp(" + repr(os.environ.get("JAVA", "java")) + ", [" + repr(os.environ.get("JAVA", "java")) + ", '-jar', " + repr(str(jar)) + ", *sys.argv[1:]])\n"
            )
            binary.chmod(0o755)
            return ["true"]
        raise ValueError(f"unknown build kind: {kind}")

    def _acquire(self, lock: Path, binary: Path, failed: Path) -> None:
        timeout = int(os.environ.get("PROBE_HARNESS_BUILD_LOCK_TIMEOUT", "600"))
        started = time.monotonic()
        while True:
            try:
                lock.mkdir()
                (lock / "owner").write_text(f"pid={os.getpid()}\nstarted={dt.datetime.now().astimezone().isoformat()}\n")
                return
            except FileExistsError:
                if failed.is_file() and failed.stat().st_size:
                    self._show_failure(failed, cached=True)
                if self._stale(lock):
                    stolen = lock.with_name(f"{lock.name}.stale.{os.getpid()}")
                    try:
                        lock.rename(stolen)
                        shutil.rmtree(stolen, ignore_errors=True)
                        print(f"[probe] reaped stale harness build lock: {lock}", file=sys.stderr)
                    except OSError:
                        pass
                if time.monotonic() - started >= timeout:
                    raise RuntimeError(f"timed out waiting for harness build lock: {lock}")
                time.sleep(0.05)

    def _stale(self, lock: Path) -> bool:
        owner = lock / "owner"
        try:
            owner_text = owner.read_text(errors="ignore")
        except OSError:
            owner_text = ""
        match = re.search(r"^pid=([0-9]+)", owner_text, re.M)
        if match:
            try:
                os.kill(int(match.group(1)), 0)
                return False
            except ProcessLookupError:
                return True
            except PermissionError:
                return False
        grace = int(os.environ.get("PROBE_HARNESS_LOCK_STALE_MIN", "5")) * 60
        try:
            mtime = lock.stat().st_mtime
        except OSError:
            # The lock (or its owner) vanished mid-check because a concurrent
            # holder released it. It is not stale — the next mkdir simply
            # acquires it. Falling through here would crash the waiter and let
            # it delete a lock it never owned.
            return False
        return grace <= 0 or time.time() - mtime > grace

    def _show_failure(self, path: Path, *, cached: bool = False) -> None:
        data = path.read_bytes()
        head = _nonnegative_int(os.environ.get("PROBE_BUILD_LOG_HEAD_BYTES", "8192"), 8192)
        tail = _nonnegative_int(os.environ.get("PROBE_BUILD_LOG_TAIL_BYTES", "8192"), 8192)
        prefix = "cached harness build failure" if cached else "harness build failed"
        print(f"[probe] {prefix}: {self.source}", file=sys.stderr)
        print(f"[probe] full compiler log: {path}", file=sys.stderr)
        if len(data) <= head + tail + 256:
            sys.stderr.buffer.write(data)
        else:
            sys.stderr.buffer.write(data[:head])
            print(f"\n[probe] compiler log elided {len(data) - head - tail} bytes; full log: {path}", file=sys.stderr)
            sys.stderr.buffer.write(data[-tail:])
        raise RuntimeError("harness build failed")


class Probe:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        # None until `execute` times a run. Recording a state row without one
        # would mean the control flow changed, so it must not read as 0.0.
        self.elapsed_seconds: float | None = None
        self.testcase = self._resolve_testcase(Path(args.testcase))
        self.config = load_config(self.testcase)
        self.testcase = self.testcase.resolve()
        self._validate_location()
        self.agent = self._agent_number()
        self.header = parse_header(self.testcase)
        if self.args.hypothesis_id:
            self.header["hypothesis"] = self.args.hypothesis_id
        if self.args.harness:
            self.header["harness"] = self.args.harness
        if self.args.property:
            self.header["property"] = self.args.property
        hypothesis_row = self._hypothesis_from_state(self.header["hypothesis"])
        self.hypothesis_strategy = strategies.normalize(str(
            hypothesis_row.get("strategy", "") if hypothesis_row else ""
        ))
        if not self.hypothesis_strategy:
            for name in (f"strategy-{self.agent}", "fixed-strategy"):
                path = Path(self.config.results_dir) / "state" / name
                try:
                    self.hypothesis_strategy = strategies.normalize(
                        path.read_text(encoding="utf-8")
                    )
                except OSError:
                    continue
                if self.hypothesis_strategy:
                    break
        if hypothesis_row:
            self.header["target"] = self.header["target"] or str(hypothesis_row.get("file", ""))
            self.header["card"] = self.header["card"] or str(hypothesis_row.get("card_id", ""))
        validate_s8_property(self.hypothesis_strategy, self.header["property"])
        if (
            self.hypothesis_strategy == "S7"
            and self.header["harness"]
            and self.config.runner_bin
        ):
            # A configured runner CLI is the one unambiguous input route, so a
            # hand-built driver beside it is the undocumented wrapper S7
            # forbids. A sanitizer binary is not that evidence: it may be a
            # fixed-workload test binary that never reads the testcase, and
            # S7 accepts a faithful public-API harness where no byte route
            # exists -- blocking on one stranded those targets entirely.
            raise ValueError(
                "S7 drives the configured runner, not a HARNESS file; probe "
                "a hand-crafted input through the runner, or hand an "
                "uncovered public API to S4"
            )
        self.mode = self._mode()
        default_output = self.testcase.with_suffix(".asan.txt") if self.testcase.suffix else Path(str(self.testcase) + ".asan.txt")
        internal_output = (
            os.environ.get("_TOKENFUZZ_PRIMARY_DIFFERENTIAL_OUTPUT", "")
            if os.environ.get("_TOKENFUZZ_PRIMARY_DIFFERENTIAL") == "1" else ""
        )
        self.output = Path(internal_output) if internal_output else default_output
        self.actual_runs_path = self.output.with_name(
            f".{self.output.name}.runs-{os.getpid()}-{time.time_ns()}"
        )
        self.exec_testcase = prepare_exec_testcase(self.testcase, self.config, self.agent)
        self.want = args.want or derive_want(self.header["target"])
        self.card = self.header["card"] or self._card_from_state()
        self.sanitizer = self._sanitizer()
        self.base_build_suffix = os.environ.get("AUDIT_BUILD_SUFFIX", "")
        self.selected_build_config = self._build_config()
        if self.selected_build_config is not None:
            os.environ["AUDIT_BUILD_SUFFIX"] = build_config.suffix(
                self.selected_build_config, self.base_build_suffix
            )
        # The tree is now fully resolved (sanitizer and, for an alternate
        # configuration, its suffix). Hold it so a rebuild cannot replace the
        # binary between resolving it here and finishing with it below.
        sanitizer_lib.hold_build(self.sanitizer, self.config.target_root)
        self.harness_source: Path | None = None
        self.build_kind = ""
        self.repro_args = list(self.args.args)
        self.environment = self._environment()
        self.command = self._command()

    def _resolve_testcase(self, testcase: Path) -> Path:
        relative = str(testcase)[2:] if str(testcase).startswith("./") else str(testcase)
        if re.match(r"^scratch-[0-9]+/", relative) and os.environ.get("RESULTS_DIR"):
            result_path = Path(os.environ["RESULTS_DIR"]) / relative
            if Path(relative).is_file() and result_path.is_file() and Path(relative).resolve() != result_path.resolve():
                raise ValueError(f"ambiguous scratch path: cwd {relative} exists, but probe would use {result_path}")
            testcase = result_path
        if not testcase.is_file():
            raise ValueError(f"testcase not found: {testcase}")
        return testcase

    def _validate_location(self) -> None:
        if os.environ.get("PROBE_ALLOW_EXTERNAL_TESTCASE") == "1":
            return
        results = Path(self.config.results_dir).resolve()
        if not path_under(results, self.testcase):
            raise ValueError(f"testcase must live under RESULTS_DIR/scratch-N: {self.testcase}")
        relative = self.testcase.relative_to(results)
        if not relative.parts or not re.fullmatch(r"scratch-[0-9]+", relative.parts[0]):
            raise ValueError(f"testcase must live under RESULTS_DIR/scratch-N: {self.testcase}")

    def _agent_number(self) -> str:
        match = re.search(r"/scratch-([0-9]+)/", str(self.testcase))
        return match.group(1) if match else "1"

    def _mode(self) -> str:
        mode = self.args.mode
        if mode == "auto" and self.header["mode"]:
            mode = self.header["mode"]
        if mode == "auto":
            page_browser = (
                self.config.is_browser in {"1", "true", "True"}
                and target_config.browser_page_launch_configured(self.config)
            )
            if self.testcase.suffix.lower() in {".html", ".htm", ".xhtml", ".svg"}:
                mode = "browser"
            elif self.testcase.suffix.lower() in {".js", ".mjs"}:
                mode = "js" if page_browser else "generic"
            else:
                mode = "browser" if page_browser else "generic"
        if mode not in VALID_MODES - {"auto"}:
            raise ValueError(f"invalid mode: {mode}")
        return mode

    def _card_from_state(self) -> str:
        row = self._hypothesis_from_state(self.header["hypothesis"])
        return str(row.get("card_id", "")) if row else ""

    def _hypothesis_from_state(self, hypothesis: str) -> dict | None:
        state = Path(self.config.results_dir) / "state/hypotheses.jsonl"
        if not hypothesis or not state.is_file():
            return None
        by_agent: dict[str, dict] = {}
        for line in state.read_text(errors="replace").splitlines():
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if row.get("id") == hypothesis:
                by_agent[str(row.get("agent", ""))] = row
        if self.agent in by_agent:
            return by_agent[self.agent]
        # Analysis-to-reproduce handoffs retain the original agent on the
        # hypothesis. A globally unique id is still unambiguous provenance.
        return next(iter(by_agent.values())) if len(by_agent) == 1 else None

    def _sanitizer(self) -> str:
        selected = os.environ.get("PROBE_SANITIZER", "").lower()
        if not selected:
            selected = "runner" if self.config.sanitizers_explicitly_disabled else (self.config.sanitizers_enabled[0] if self.config.sanitizers_enabled else "asan")
        if selected not in VALID_SANITIZERS:
            raise ValueError(f"unsupported sanitizer: {selected}")
        if selected != "runner":
            if self.config.sanitizers_explicitly_disabled:
                raise ValueError("target.toml has [sanitizer].enabled = []; use PROBE_SANITIZER=runner or enable a sanitizer")
            if selected not in self.config.sanitizers_enabled and os.environ.get("PROBE_ALLOW_DISABLED_SANITIZER") != "1":
                raise ValueError(f"sanitizer '{selected}' is not enabled for this target; enabled sanitizers: {self.config.sanitizers_enabled_csv()}")
        if self.mode not in MODE_MATRIX[selected]:
            raise ValueError(f"sanitizer '{selected}' does not support mode '{self.mode}'")
        return selected

    def _build_config(self) -> build_config.BuildConfig | None:
        explicit = os.environ.get("PROBE_BUILD_CONFIG", "").strip()
        selector = explicit
        if not selector:
            assignment = Path(self.config.results_dir) / "state" / f"build-config-{self.agent}"
            try:
                selector = assignment.read_text(encoding="utf-8").strip()
            except OSError:
                selector = ""
        if not selector or selector == "primary":
            return None
        if self.sanitizer != "asan":
            if explicit:
                raise ValueError("alternate build configurations are ASan-only; omit PROBE_BUILD_CONFIG for other sanitizers")
            return None
        selected = build_config.find(self.config.build_configs, selector)
        if selected is None:
            choices = ", ".join(item.name for item in self.config.build_configs)
            raise ValueError(f"unknown build config {selector!r}; available: {choices or 'none'}")
        recipe = build_config.recipe_path(self.config.target_root, selected)
        tree = build_config.build_dir(
            self.config.target_root, selected, base_suffix=self.base_build_suffix
        )
        if not (
            recipe.is_file()
            and build_config.is_ready(tree, recipe)
        ):
            raise ValueError(
                f"build config {selected.name!r} is not ready; run "
                f"bin/build-configs --target {self.config.slug} --config {selected.name}"
            )
        return selected

    def _environment(self) -> dict[str, str]:
        environment = dict(os.environ)
        environment.update({
            "RESULTS_DIR": self.config.results_dir, "TARGET_ROOT": self.config.target_root,
            "TARGET_SLUG": self.config.slug, "TARGET_REV": self.config.target_rev,
            "LOGDIR": self.config.logdir, "AUDIT_AGENT_NUM": self.agent,
            "TRIED_INPUTS_LOG": str(Path(self.config.results_dir) / f"tried-inputs-{self.agent}.log"),
            "HITS_LOG_PATH": str(Path(self.config.results_dir) / f"hits-{self.agent}.log"),
            "ASAN_OUTPUT_FILE": str(self.output), "PROBE_SANITIZER_SELECTED": self.sanitizer,
            "SANITIZER_RUNS": str(sanitizer_run_count(self.args, environment)),
            "SANITIZER_RUNS_ACTUAL_FILE": str(self.actual_runs_path),
        })
        self.actual_runs_path.unlink(missing_ok=True)
        environment["PROBE_BUILD_CONFIG_SELECTED"] = (
            self.selected_build_config.config_id if self.selected_build_config else "primary"
        )
        if self.header["hypothesis"]:
            environment["HYPOTHESIS_ID"] = self.header["hypothesis"]
        if self.header["target"]:
            environment["TARGET"] = self.header["target"]
        if self.want:
            environment["WANT"] = self.want
        if self.exec_testcase != self.testcase:
            environment["ASAN_RECORDED_TESTCASE"] = str(self.testcase)
        return environment

    def _command(self) -> list[str]:
        override = ""
        preargs: list[str] = []
        harness = self.header["harness"]
        if harness:
            raw = Path(harness)
            if os.environ.get("PROBE_ALLOW_EXTERNAL_HARNESS") != "1" and (raw.is_absolute() or ".." in raw.parts):
                raise ValueError(f"HARNESS must stay under the testcase directory: {harness}")
            source = (self.testcase.parent / raw).resolve()
            if not source.is_file():
                raise ValueError(f"HARNESS source not found: {source}")
            if os.environ.get("PROBE_ALLOW_EXTERNAL_HARNESS") != "1" and not path_under(self.testcase.parent, source):
                raise ValueError(f"HARNESS resolves outside testcase directory: {harness}")
            self.harness_source = source
            override, preargs, self.build_kind = HarnessBuilder(self, source).build()
            self.mode = "generic"
        elif self._runs_cargo() and self.exec_testcase.suffix.lower() == ".rs":
            override, preargs, self.build_kind = HarnessBuilder(
                self, self.exec_testcase,
            ).build()
        elif self._runs_cargo() and target_config.cargo_package_is_library_only(
            self.config.target_root,
        ):
            raise ValueError(
                "Cargo library target has no binary for opaque input; write a "
                "direct .rs public-API testcase, or a `// HARNESS: <name>.rs` "
                "driver beside the input, and run it with bin/probe"
            )
        elif self.mode == "generic" and self.exec_testcase.suffix.lower() in {".ts", ".tsx"} and self._can_use_runner():
            if Path(self.config.runner_bin).name == "node":
                ts_node = Path(self.config.target_root) / "node_modules/.bin/ts-node"
                found = str(ts_node) if os.access(ts_node, os.X_OK) else shutil.which("ts-node") or ""
                if found:
                    override = found
                    preargs = ["--transpile-only", "--skip-project", "--compiler-options", '{"module":"CommonJS","moduleResolution":"node","target":"ES2022","ignoreDeprecations":"6.0"}']
        if self.mode in {"browser", "js"}:
            if self.mode == "browser":
                configured = (
                    list(self.config.runner_args)
                    if self.config.runner_args
                    else target_config.browser_runner_defaults(
                        self.config.build_system
                    ).get("args", [])
                )
                self.repro_args = list(configured)
                if not any("{TESTCASE}" in value for value in self.repro_args):
                    self.repro_args.append("{TESTCASE}")
                self.repro_args.extend(self.args.args)
            return [str(BIN_DIR / "run-sanitizer-multi"), self.sanitizer, self.mode, str(self.exec_testcase), *self.args.args]

        uses_runner = False
        uses_sanitizer_args = False
        raw_bin = self.config.sanitizer_bin(self.sanitizer)
        if override:
            binary = override
        elif raw_bin:
            binary = self.config.resolve_path(raw_bin)
            # A native sanitizer CLI may need an input flag or a sink argument
            # instead of accepting the testcase positionally. Reuse the
            # existing argv template without replacing the instrumented binary.
            uses_sanitizer_args = bool(
                self.config.runner_args
                and not self.config.runner_bin
                and str(getattr(self.config, "is_browser", "0")).lower()
                not in {"1", "true"}
            )
        elif self.config.runner_bin:
            binary = resolve_executable(self.config.runner_bin, self.config)
            uses_runner = True
        else:
            binary = ""
        env_name = f"{self.sanitizer.upper()}_GENERIC_BIN" if self.sanitizer in {"asan", "ubsan", "msan", "tsan"} else "ASAN_GENERIC_BIN"
        if binary:
            self.environment[env_name] = binary
        if self.sanitizer in {"runner", "race"}:
            self.environment["ASAN_GENERIC_DISABLE_OPTIONS"] = "1"
        generic_args: list[str] = []
        skip = False
        if (
            not harness and not preargs
            and (uses_runner or uses_sanitizer_args)
            and self.config.runner_args
        ):
            generic_args = [
                sanitizer_run.expand_runner_value(
                    value, self.config, self.sanitizer,
                    testcase=str(self.exec_testcase),
                )
                for value in self.config.runner_args
            ]
            skip = any("{TESTCASE}" in value for value in self.config.runner_args)
            if not skip:
                generic_args.append(str(self.exec_testcase))
                skip = True
            self.repro_args = [
                sanitizer_run.expand_runner_value(
                    value, self.config, self.sanitizer,
                    testcase="{TESTCASE}",
                )
                for value in self.config.runner_args
            ]
            if "{TESTCASE}" not in self.repro_args:
                self.repro_args.append("{TESTCASE}")
            self.repro_args.extend(self.args.args)
        elif preargs:
            generic_args = [*preargs, str(self.exec_testcase)]
            skip = True
        elif self.build_kind == "rust" and not harness:
            # A direct .rs testcase compiled itself; there is no input to pass.
            skip = True
        elif self.exec_testcase != self.testcase:
            generic_args = [str(self.exec_testcase)]
            skip = True
        self.environment["ASAN_GENERIC_SKIP_TESTCASE"] = "1" if skip else "0"
        self.environment["SANITIZER_GENERIC_SKIP_TESTCASE"] = "1" if skip else "0"
        # Only this process knows whether the configured runner won the route.
        runner_cwd = self.config.target_root if uses_runner else ""
        self.environment["ASAN_GENERIC_RUNNER_CWD"] = runner_cwd
        self.environment["SANITIZER_GENERIC_RUNNER_CWD"] = runner_cwd
        return [
            str(BIN_DIR / "run-sanitizer-multi"), self.sanitizer, "generic",
            str(self.exec_testcase), *generic_args, *self.args.args,
        ]

    def _runs_cargo(self) -> bool:
        """Whether this probe's route is the configured `cargo` runner."""
        return (
            self.mode == "generic"
            and self._can_use_runner()
            and Path(self.config.runner_bin).name == "cargo"
        )

    def _can_use_runner(self) -> bool:
        return bool(self.config.runner_bin and (self.sanitizer in {"runner", "race"} or not self.config.sanitizer_bin(self.sanitizer)))

    def dry_run(self) -> int:
        print(
            f"[probe] mode={self.mode} sanitizer={self.sanitizer} asan_output={self.output} "
            f"build_config={self.selected_build_config.name if self.selected_build_config else 'primary'} "
            f"target={self.header['target']} hypothesis={self.header['hypothesis']} "
            f"want={self.want} card={self.card}"
        )
        if self.exec_testcase != self.testcase:
            print(f"[probe] exec_testcase={self.exec_testcase} original_testcase={self.testcase}")
        print(f"[probe] command: {shlex.join(self.command)}")
        return 0

    def execute(self) -> int:
        confirmation = " confirm=1" if self.args.confirm else ""
        print(
            f"[probe] mode={self.mode} testcase={self.testcase} asan_output={self.output}"
            f" build_config={self.selected_build_config.name if self.selected_build_config else 'primary'}{confirmation}"
        )
        if Path(self.command[0]).name == "run-sanitizer-multi":
            self.actual_runs_path.write_text("0\n", encoding="utf-8")
        started = time.monotonic()
        completed = subprocess.run(self.command, env=self.environment, check=False)
        result = completed.returncode
        probe_verdict = self._classify(result)
        result, probe_verdict = self._auto_route(result, probe_verdict)
        # Stop after routing, not after the first attempt: `_auto_route` re-runs
        # the whole command once per candidate build, and the recorded verdict
        # is the one it returns. Timing only the canonical attempt would
        # undercount exactly the multi-build probes worth seeing.
        self.elapsed_seconds = max(0.0, time.monotonic() - started)
        self.environment["SANITIZER_RUNS"] = str(self._actual_sanitizer_runs())
        self._cap_output()
        probe_verdict = self._reject_foreign_image(probe_verdict)
        self._write_internal_differential_result(probe_verdict)
        print(f"[probe] verdict={probe_verdict}")
        self._record_state(probe_verdict)
        self._file_crash(probe_verdict)
        return 0 if probe_verdict == "PROPERTY" else result

    def _actual_sanitizer_runs(self) -> int:
        try:
            records = self.actual_runs_path.read_text(encoding="utf-8").splitlines()
        except OSError:
            return int(self.environment["SANITIZER_RUNS"])
        finally:
            self.actual_runs_path.unlink(missing_ok=True)
        values = []
        for line in records:
            try:
                values.append(max(0, int(line.strip())))
            except ValueError:
                continue
        return sum(values)

    def _ran_binary(self) -> str:
        return self.environment.get(
            f"{self.sanitizer.upper()}_GENERIC_BIN"
            if self.sanitizer in {"asan", "ubsan", "msan", "tsan"}
            else "ASAN_GENERIC_BIN",
            "",
        )

    def _reject_foreign_image(self, probe_verdict: str) -> str:
        """Downgrade a diagnostic that did not come from the binary we built.

        This runs before the verdict is recorded, not at filing time. A CRASH
        written to run state is already a measurement: it raises the strategy's
        crash yield, marks the session productive, and can satisfy a work
        card's evidence gate. Refusing only the bundle would leave all of that
        standing behind a diagnostic about some other binary.

        `NO_EXEC` is what the run actually established — output exists, but it
        does not attribute a target execution — so nothing downstream needs a
        new verdict to understand.
        """
        if probe_verdict != "CRASH":
            return probe_verdict
        try:
            output = self.output.read_text(encoding="utf-8", errors="replace")
            foreign = foreign_crash_images(
                output, self._ran_binary(), self.config.results_dir,
            )
            if not foreign:
                foreign = foreign_crash_main_sources(
                    output, self.harness_source, self.config.results_dir,
                )
        except OSError:
            return probe_verdict
        if not foreign:
            return probe_verdict
        print(
            f"[probe] NOT A TARGET CRASH: the diagnostic came from {foreign[0]}, "
            "which bin/probe did not build. A HARNESS must reach the target "
            "itself, so the binary that crashes is the one probe compiled and a "
            "bundle can ship it; handing control to a separately built binary "
            "leaves evidence about that binary instead.",
            file=sys.stderr,
        )
        return "NO_EXEC"

    def _classify(self, returncode: int) -> str:
        if self.output.is_file() and self.output.stat().st_size:
            if self.sanitizer == "runner":
                testcase_failure = verdict_lib.runner_testcase_failure(
                    self.output, self.exec_testcase,
                )
                if testcase_failure == "unavailable":
                    return "NO_EXEC"
                if testcase_failure == "assertion":
                    return "EXEC_FAIL"
            if verdict_lib.file_has_crash(self.output, tuple(self.config.runner_crash_patterns)):
                return "CRASH"
            # A property marker is agent-authored output, while 124 is the
            # timeout wrapper's reserved process result. An oracle that prints
            # its marker and then hangs did not complete, so do not credit the
            # marker as a counterexample. A concrete crash above remains valid
            # evidence even when the wrapper later reaches its deadline.
            if returncode == 124:
                return "TIMEOUT"
            if (
                self.hypothesis_strategy == "S8"
                and self.header["property"]
                and file_has_property_violation(self.output, returncode)
            ):
                return "PROPERTY"
            if verdict_lib.file_is_clean(self.output):
                return "CLEAN"
            # The command ran and returned without completing cleanly. That is
            # EXEC_FAIL, the verdict run-sanitizer-multi and bin/scratch-status
            # already record for it; bin/probe was the only producer collapsing
            # it into NO_EXEC, which sends the agent to repair a harness that
            # may be working. On measured 5h cells 133 of 150 NO_EXEC rows had
            # in fact reached this point. Which repair it needs is in the
            # output, not in the marker.
            if verdict_lib.file_execution_attempted(self.output):
                return "EXEC_FAIL"
            return "NO_EXEC"
        if returncode == 124:
            return "TIMEOUT"
        return "CLEAN" if returncode == 0 else "NO_EXEC"

    def _auto_route(self, returncode: int, current: str) -> tuple[int, str]:
        binary = self.environment.get("ASAN_GENERIC_BIN", "")
        if os.environ.get("PROBE_AUTO_ROUTE", "1") == "0" or self.mode != "generic" or self.sanitizer != "asan" or current in {"CRASH", "PROPERTY"} or not binary or not self.output.is_file():
            return returncode, current
        feature = feature_disabled_marker(self.output)
        if not feature:
            return returncode, current
        keys = ([f"card:{self.card}"] if self.card else []) + ([f"file:{self.header['target'].split(':')[0]}"] if self.header["target"] else [])
        candidates: list[str] = []
        cached = build_routes.lookup_route(Path(self.config.results_dir), *keys) if keys else ""
        if cached:
            candidates.append(cached)
        candidates.extend(str(candidate.binary) for candidate in build_routes.enumerate_sibling_builds(Path(self.config.target_root), Path(binary)) if str(candidate.binary) != cached)
        for candidate in candidates:
            if not os.access(candidate, os.X_OK):
                continue
            environment = {**self.environment, "ASAN_GENERIC_BIN": candidate}
            with capture_command(
                self.command, merge_stderr=True, env=environment
            ) as completed:
                if feature_disabled_marker(completed.stdout):
                    continue
                shutil.copy2(completed.stdout, self.output)
                routed = self._classify(completed.returncode)
            print(f"[probe] ROUTED: feature='{feature}' canonical='{binary}' -> '{candidate}' verdict={routed}")
            for key in keys:
                build_routes.record_route(Path(self.config.results_dir), key=key, binary=candidate, feature=feature, canonical_binary=binary)
            self.environment["ASAN_GENERIC_BIN"] = candidate
            routed_config = build_config.config_for_binary(
                self.config.build_configs, self.config.target_root, candidate,
                base_suffix=self.base_build_suffix,
            )
            if routed_config is not None:
                self.selected_build_config = routed_config
                self.environment["PROBE_BUILD_CONFIG_SELECTED"] = routed_config.config_id
            return completed.returncode, routed
        print(f"[probe] ROUTE_MISS: feature='{feature}' canonical='{binary}' - no sibling build exercised this feature")
        return returncode, current

    def _cap_output(self) -> None:
        if not self.output.is_file() or not self.output.stat().st_size:
            return
        maximum = _nonnegative_int(os.environ.get("PROBE_ASAN_OUTPUT_MAX_BYTES", "8388608"), 8388608)
        head = _nonnegative_int(os.environ.get("PROBE_ASAN_OUTPUT_HEAD_BYTES", "262144"), 262144)
        tail = _nonnegative_int(os.environ.get("PROBE_ASAN_OUTPUT_TAIL_BYTES", "262144"), 262144)
        size = self.output.stat().st_size
        if maximum and size > maximum:
            marker = (
                f"[probe] ASAN_OUTPUT_FILE truncated for storage after verdict classification: original_size_bytes={size} max_bytes={maximum}\n"
                f"[probe] showing first {head} byte(s) and last {tail} byte(s); rerun with PROBE_ASAN_OUTPUT_MAX_BYTES=0 to preserve full output.\n"
            ).encode()
            fd, temporary_name = tempfile.mkstemp(
                prefix=f".{self.output.name}.", dir=self.output.parent
            )
            try:
                with os.fdopen(fd, "wb") as target, self.output.open("rb") as source:
                    target.write(marker)
                    target.write(source.read(head))
                    target.write(b"\n[probe] ... middle omitted from oversized ASan output ...\n")
                    source.seek(max(0, size - tail))
                    shutil.copyfileobj(source, target, 1024 * 1024)
                os.replace(temporary_name, self.output)
            except BaseException:
                Path(temporary_name).unlink(missing_ok=True)
                raise

    def _state_command(self, *args: str) -> None:
        state = BIN_DIR / "state"
        if not os.access(state, os.X_OK):
            return
        subprocess.run([
            str(state), "--results-dir", self.config.results_dir, "--target-path", self.config.target_root,
            "--target-slug", self.config.slug, *args,
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    def _record_state(self, probe_verdict: str) -> None:
        if os.environ.get("_TOKENFUZZ_PRIMARY_DIFFERENTIAL") == "1":
            return
        hypothesis = self.header["hypothesis"]
        if not hypothesis:
            return
        # EXEC_FAIL and NO_EXEC are otherwise indistinguishable in the ledger: a
        # target that rejected a malformed input and a loader that could not
        # start read the same. The post-run marker carries the child's exit
        # code, so record it here so telemetry can split the two without
        # reopening the output file.
        reason = (
            verdict_lib.execution_exit_reason(self.output)
            if probe_verdict in {"EXEC_FAIL", "NO_EXEC"} else ""
        )
        self._state_command(
            "add-run", "--agent", self.agent, "--hypothesis-id", hypothesis, "--card-id", self.card,
            "--mode", self.mode, "--testcase", str(self.testcase),
            "--testcase-sha1", hashlib.sha1(self.testcase.read_bytes()).hexdigest(),
            "--asan-output", str(self.output), "--verdict", probe_verdict,
            "--sanitizer", self.sanitizer,
            "--sanitizer-runs", self.environment["SANITIZER_RUNS"],
            *(["--reason", reason] if reason else []),
            *(
                ["--duration-seconds", f"{self.elapsed_seconds:.3f}"]
                if self.elapsed_seconds is not None else []
            ),
        )
        if probe_verdict == "CRASH" and self.sanitizer != "runner":
            self._state_command(
                "add-note", "--agent", self.agent, "--hypothesis-id", hypothesis,
                "--card-id", self.card, "--kind", "decision",
                "--text", "bin/probe observed a sanitizer diagnostic; keep hypothesis/card active until the filed crash report is complete",
            )
        elif probe_verdict == "CRASH":
            self._state_command(
                "add-note", "--agent", self.agent, "--hypothesis-id", hypothesis,
                "--card-id", self.card, "--kind", "decision",
                "--text", (
                    "bin/probe observed a runner diagnostic in findings-only mode; "
                    "keep the hypothesis/card active until a FIND report or explicit "
                    "discard closes it. If a compact input encoded a size/count that "
                    "caused quantified memory or CPU amplification, record that as a "
                    "distinct resource-effect hypothesis and file it with the target's "
                    "size ceiling; ordinary OOM remains noise."
                ),
            )

    def _file_crash(self, probe_verdict: str) -> None:
        if os.environ.get("_TOKENFUZZ_PRIMARY_DIFFERENTIAL") == "1":
            return
        runs = int(self.environment["SANITIZER_RUNS"])
        if not crash_bundle.should_file(probe_verdict, self.sanitizer, runs):
            return
        if self.harness_source and self.build_kind == "interpret":
            print(f"[probe] WARNING: crash confirmed but auto-file skipped for interpreted HARNESS. File it under {self.config.results_dir}/crashes/.", file=sys.stderr)
            return
        strategy_path = Path(self.config.results_dir) / "state" / f"strategy-{self.agent}"
        strategy = strategy_path.read_text().strip().upper() if strategy_path.is_file() else ""
        if strategy not in strategies.ATTRIBUTABLE:
            strategy = ""
        try:
            status, crash_id = crash_bundle.materialize(
                self.config.results_dir, self.agent, self.testcase, self.output,
                self.sanitizer, self.mode, harness=self.harness_source, args=self.repro_args,
                target=self.header["target"], hypothesis=self.header["hypothesis"],
                card=self.card, strategy=strategy,
                binary=self._ran_binary(),
                build_config=self.selected_build_config,
                build_recipe=(
                    build_config.recipe_path(self.config.target_root, self.selected_build_config)
                    if self.selected_build_config else None
                ),
            )
        except OSError as exc:
            print(f"[probe] WARNING: crash confirmed but bundle could not be created: {exc}", file=sys.stderr)
            return
        crash_dir = Path(self.config.results_dir) / "crashes" / crash_id
        if self.selected_build_config is not None:
            self._run_primary_differential(crash_dir)
        if status == "FILED":
            print(f"[probe] CRASH FILED: {self.config.results_dir}/crashes/{crash_id} - reproducer + sanitizer.txt copied in; enrich report.md there")
            if self.header["hypothesis"]:
                self._state_command(
                    "add-note", "--agent", self.agent,
                    "--hypothesis-id", self.header["hypothesis"],
                    "--card-id", self.card, "--kind", "decision",
                    "--text", f"bin/probe filed {crash_id} at crashes/{crash_id}",
                )
        else:
            print(f"[probe] CRASH already filed (identical reproducer): {self.config.results_dir}/crashes/{crash_id}")

    def _write_internal_differential_result(self, probe_verdict: str) -> None:
        destination = os.environ.get("_TOKENFUZZ_PRIMARY_DIFFERENTIAL_RESULT", "")
        if os.environ.get("_TOKENFUZZ_PRIMARY_DIFFERENTIAL") != "1" or not destination:
            return
        binary_key = (
            f"{self.sanitizer.upper()}_GENERIC_BIN"
            if self.sanitizer in {"asan", "ubsan", "msan", "tsan"}
            else "ASAN_GENERIC_BIN"
        )
        payload = {
            "version": 1,
            "testcase_sha1": hashlib.sha1(self.testcase.read_bytes()).hexdigest(),
            "build_config": self.selected_build_config.config_id if self.selected_build_config else "primary",
            "verdict": probe_verdict,
            "binary": crash_bundle.binary_identity(self.environment.get(binary_key, "")),
        }
        path = Path(destination)
        temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
        try:
            temporary.write_text(json.dumps(payload, sort_keys=True) + "\n", encoding="utf-8")
            os.replace(temporary, path)
        except OSError as exc:
            temporary.unlink(missing_ok=True)
            print(f"[probe] WARNING: primary-build comparison result could not be saved: {exc}", file=sys.stderr)

    def _run_primary_differential(self, crash_dir: Path) -> None:
        if crash_bundle.verified_primary_differential(crash_dir) is not None:
            return
        token = f"{os.getpid()}-{time.time_ns()}"
        primary_output = crash_dir / f".primary-build-run-{token}.txt"
        primary_result = crash_dir / f".primary-build-run-{token}.json"
        environment = os.environ.copy()
        environment.update({
            "PROBE_BUILD_CONFIG": "primary",
            "PROBE_AUTO_ROUTE": "0",
            "_TOKENFUZZ_PRIMARY_DIFFERENTIAL": "1",
            "_TOKENFUZZ_PRIMARY_DIFFERENTIAL_OUTPUT": str(primary_output),
            "_TOKENFUZZ_PRIMARY_DIFFERENTIAL_RESULT": str(primary_result),
        })
        if self.base_build_suffix:
            environment["AUDIT_BUILD_SUFFIX"] = self.base_build_suffix
        else:
            environment.pop("AUDIT_BUILD_SUFFIX", None)
        command = [str(BIN_DIR / "probe")]
        if self.args.mode != "auto":
            command += ["--mode", self.args.mode]
        # Both flags an opaque input needs must survive the recursion. Dropping
        # --harness re-ran a harness crash against the target's own CLI, which
        # does not read that input at all, and recorded the miss as "did not
        # reproduce on the primary build".
        if self.args.harness:
            command += ["--harness", self.args.harness]
        if self.args.hypothesis_id:
            command += ["--hypothesis-id", self.args.hypothesis_id]
        if self.args.property:
            command += ["--property", self.args.property]
        command += ["--confirm", str(self.testcase)]
        if self.args.args:
            command += ["--", *self.args.args]
        try:
            # Backstop against a wedged child probe. It already bounds each of
            # its 5 confirm runs by ASAN_TIMEOUT and any harness build by the
            # build lock, so this only trips on a genuine hang; the generous
            # margin avoids interrupting a legitimate slow rebuild. Fail-open:
            # a timeout leaves no result file, so triage keeps ordinary review.
            per_run = int(os.environ.get("ASAN_TIMEOUT", "15"))
            lock_wait = int(os.environ.get("PROBE_HARNESS_BUILD_LOCK_TIMEOUT", "600"))
            deadline = lock_wait + max(per_run, 1) * 5 * 4
            run_timeout(
                command,
                deadline,
                env=environment,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            raw_result = json.loads(primary_result.read_text(encoding="utf-8"))
            evidence = crash_bundle.record_primary_differential(
                crash_dir, primary_output, raw_result,
            )
            if evidence is None:
                print(
                    "[probe] WARNING: primary-build comparison was unavailable; "
                    "triage will keep ordinary review enabled",
                    file=sys.stderr,
                )
            else:
                print(
                    f"[probe] PRIMARY BUILD DIFFERENTIAL: {evidence['status']} "
                    f"(alternate={self.selected_build_config.name})"
                )
        except (OSError, ValueError) as exc:
            print(
                f"[probe] WARNING: primary-build comparison was unavailable: {exc}; "
                "triage will keep ordinary review enabled",
                file=sys.stderr,
            )
        finally:
            primary_output.unlink(missing_ok=True)
            primary_result.unlink(missing_ok=True)


def main(argv: Sequence[str] | None = None) -> int:
    try:
        args = parse_args(sys.argv[1:] if argv is None else argv)
        probe = Probe(args)
        return probe.dry_run() if args.dry_run else probe.execute()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as exc:
        print(f"[probe] {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
