"""Coverage-gated sanitizer testcase runner."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Mapping, Sequence

ROOT = Path(__file__).resolve().parent.parent
BIN_DIR = ROOT / "bin"
LIB_DIR = ROOT / "lib"
sys.path.insert(0, str(LIB_DIR))

import build_routes
import build_config
import crash_bundle
import languages
import runner_preflight
import sanitizer as sanitizer_lib
import sanitizer_run
import stack_frames
