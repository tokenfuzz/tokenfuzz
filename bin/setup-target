#!/usr/bin/env python3
"""Clone or update a target and seed its audit configuration."""

from __future__ import annotations

import argparse
import contextlib
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

SCRIPT_ROOT = Path(os.environ.get("AUDIT_ROOT", Path(__file__).resolve().parent.parent)).resolve()
sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

import build_materialize
import build_lease
import fuzz_harness
import languages
import runner_canary
import runner_preflight
import sanitizer
import target_config
import target_profile

RESERVED = {"output", "benchmark"}


def log(message: str) -> None:
    print(f"[setup-target] {message}")


def run(command: list[str], *, cwd: Path | None = None, check: bool = True, env=None) -> subprocess.CompletedProcess:
    return subprocess.run(command, cwd=cwd, check=check, env=env)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Examples: setup-target pcre2 https://github.com/PCRE2Project/pcre2; setup-target myparser ~/code/myparser",
    )
    parser.add_argument("target")
    parser.add_argument("source", nargs="?", default="")
    parser.add_argument("--repo-type", choices=("auto", "git", "hg"), default="auto")
    parser.add_argument("--ref", default="")
    update = parser.add_mutually_exclusive_group()
    update.add_argument("--no-update", action="store_true")
    update.add_argument(
        "--pull", action="store_true",
        help="update an existing VCS checkout to the latest upstream source "
             "without re-passing its repo URL",
    )
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--build", action="store_true")
    parser.add_argument(
        "--browser", action=argparse.BooleanOptionalAction, default=None,
        help="select browser execution mode; browser-specific drivers are "
             "inferred, while shared drivers such as GN require this flag",
    )
    parser.add_argument(
        "--no-alternates", action="store_true",
        help="build only the canonical sanitizer trees, skipping cached "
             "alternate ASan configurations",
    )
    parser.add_argument("--no-llm-config", action="store_true")
    return parser.parse_args(argv)


def validate_target(name: str) -> None:
    if name.startswith("/") or name.endswith("/") or "//" in name:
        raise ValueError("target name must not start or end with '/' or contain empty components")
    for component in name.split("/"):
        if component in {"", ".", ".."} or component.startswith("."):
            raise ValueError("each target path component must be a plain name")
        if component in RESERVED:
            raise ValueError(f"'{component}' is a reserved directory name and cannot be a target path component")
        if not re.fullmatch(r"[A-Za-z0-9._-]+", component):
            raise ValueError("target components may contain only letters, numbers, dot, underscore, or dash")


class Setup:
    def __init__(self, args: argparse.Namespace):
        validate_target(args.target)
        self.args = args
        self.requested_name, self.profile = target_profile.resolve(
            SCRIPT_ROOT, args.target
        )
        self.name = (
            f"{self.requested_name}/{self.profile.source_subdir}"
            if self.profile is not None
            else args.target
        )
        self.source = args.source
        self.workspace_root = SCRIPT_ROOT / "targets" / self.requested_name
        self.target_root = SCRIPT_ROOT / "targets" / self.name
        self.config_dir = SCRIPT_ROOT / "output" / self.name
        self.toml = self.config_dir / "target.toml"
        self.seeded_full = False
        if self.profile is not None and self.args.browser is None:
            self.args.browser = self.profile.browser

    def detect_type(self, root: Path | None = None) -> str:
        candidate = root or self.target_root
        if candidate.is_dir():
            detected = target_config.detect_repo_type(candidate)
            if detected != "none" or root is not None:
                return detected
        if self.source:
            source_path = Path(self.source).expanduser()
            if source_path.is_dir():
                detected = target_config.detect_repo_type(source_path)
                if detected != "none":
                    return detected
            if "hg.mozilla.org" in self.source or self.source.startswith("hg:") or self.source.endswith(".hg"):
                return "hg"
        return "git"

    def prepare_source(self) -> None:
        if self.profile is not None and self.profile.checkout == "gclient":
            self.prepare_gclient_source()
            return
        if self.target_root.is_dir():
            detected = self.detect_type(self.target_root)
            if self.args.repo_type != "auto" and self.args.repo_type != detected:
                raise ValueError(f"targets/{self.name} is {detected}, not {self.args.repo_type}")
            if detected == "none":
                if self.source or self.args.ref or self.args.pull:
                    log(f"Using existing targets/{self.name} as a plain source tree (no VCS metadata; repo URL/ref/--pull ignored)")
                else:
                    log(f"Using existing targets/{self.name} as a plain source tree")
                self.source = ""
            elif self.args.no_update or not (
                self.source or self.args.ref or self.args.pull
            ):
                log(f"Using existing targets/{self.name} without updating")
            elif detected == "git":
                self.sync_git()
            else:
                self.sync_hg()
            return
        source_path = Path(self.source).expanduser() if self.source else None
        if source_path and source_path.is_dir() and target_config.detect_repo_type(source_path) == "none":
            if self.args.repo_type != "auto":
                raise ValueError(f"{self.source} is a plain source tree, not a {self.args.repo_type} repo; omit --repo-type to symlink it")
            self.link_target(source_path)
            self.source = ""
            return
        if not self.source:
            raise ValueError(f"targets/{self.name} does not exist; pass a repo URL to clone it")
        repo_type = self.args.repo_type if self.args.repo_type != "auto" else self.detect_type()
        self.clone(repo_type)

    def depot_tool(self, name: str) -> Path:
        found = shutil.which(name)
        candidates = [
            Path(found) if found else None,
            self.target_root / "third_party" / "depot_tools" / name,
        ]
        for candidate in candidates:
            if (
                candidate is not None
                and candidate.is_file()
                and os.access(candidate, os.X_OK)
            ):
                return candidate
        raise RuntimeError(
            f"{name} is required for the {self.requested_name} checkout; "
            "install depot_tools and put it on PATH"
        )

    def sync_gclient(self) -> None:
        gclient = self.depot_tool("gclient")
        log(f"Syncing gclient dependencies for targets/{self.name}")
        environment = os.environ.copy()
        environment["PATH"] = (
            f"{gclient.parent}{os.pathsep}{environment.get('PATH', '')}"
        )
        run(
            [str(gclient), "sync"],
            cwd=self.workspace_root,
            env=environment,
        )

    def prepare_gclient_source(self) -> None:
        assert self.profile is not None
        if self.args.repo_type not in ("auto", "git"):
            raise ValueError(
                f"targets/{self.requested_name} uses a git-backed gclient checkout"
            )
        if self.source:
            raise ValueError(
                f"targets/{self.requested_name} uses the upstream gclient "
                "checkout; omit the source URL"
            )
        metadata = self.workspace_root / ".gclient"
        if (
            self.target_root.is_dir()
            and target_config.detect_repo_type(self.target_root) == "git"
        ):
            if not metadata.is_file():
                raise ValueError(
                    f"targets/{self.requested_name} has src but no .gclient metadata"
                )
            if self.args.no_update or not (
                self.source or self.args.ref or self.args.pull
            ):
                log(f"Using existing targets/{self.name} without updating")
                return
            if self.blocked_by_local_edits():
                return
            if self.args.ref:
                run([
                    "git", "-C", str(self.target_root), "fetch",
                    "origin", self.args.ref,
                ])
                run([
                    "git", "-C", str(self.target_root), "checkout",
                    self.args.ref,
                ])
            else:
                log(f"Fast-forwarding git checkout for targets/{self.name}")
                run([
                    "git", "-C", str(self.target_root),
                    "pull", "--ff-only",
                ])
            self.sync_gclient()
            return
        if metadata.is_file():
            if self.args.no_update:
                raise ValueError(
                    f"targets/{self.requested_name} is an incomplete gclient "
                    "checkout; rerun without --no-update to resume it"
                )
            log(
                f"Resuming incomplete gclient workspace in "
                f"targets/{self.requested_name}"
            )
            self.sync_gclient()
            if (
                not self.target_root.is_dir()
                or target_config.detect_repo_type(self.target_root) != "git"
            ):
                raise RuntimeError(
                    f"gclient sync did not create targets/{self.name}"
                )
            if self.args.ref:
                run([
                    "git", "-C", str(self.target_root),
                    "checkout", self.args.ref,
                ])
                self.sync_gclient()
            return
        if self.workspace_root.exists() and any(self.workspace_root.iterdir()):
            raise ValueError(
                f"targets/{self.requested_name} exists without a complete "
                "gclient src checkout"
        )
        self.workspace_root.mkdir(parents=True, exist_ok=True)
        depot_tools = self.depot_tool("gclient").parent
        fetch = depot_tools / "fetch"
        if not fetch.is_file() or not os.access(fetch, os.X_OK):
            raise RuntimeError(f"fetch is missing from depot_tools at {depot_tools}")
        log(
            f"Fetching {self.requested_name} gclient workspace into "
            f"targets/{self.requested_name}"
        )
        run([str(fetch), *self.profile.fetch_args], cwd=self.workspace_root)
        if (
            not self.target_root.is_dir()
            or target_config.detect_repo_type(self.target_root) != "git"
            or not (self.workspace_root / ".gclient").is_file()
        ):
            raise RuntimeError(
                f"gclient fetch did not create targets/{self.name} and "
                f"targets/{self.requested_name}/.gclient"
            )
        if self.args.ref:
            run(["git", "-C", str(self.target_root), "checkout", self.args.ref])
            self.sync_gclient()

    def seed_profile_build_recipe(self) -> None:
        profile = self.profile
        if profile is None or not profile.build_recipe:
            return
        recipe = self.target_root / ".audit" / "build.sh"
        if recipe.is_file() and not self.args.force:
            return
        overlay = (
            SCRIPT_ROOT / "lib" / "target-overlays" / profile.build_recipe
        )
        if not overlay.is_file():
            raise RuntimeError(f"target build recipe is missing: {overlay}")
        recipe.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(overlay, recipe)
        recipe.chmod(0o755)
        log(f"Installed target build recipe at {recipe}")

    def link_target(self, source: Path) -> None:
        destination = source.resolve()
        self.target_root.parent.mkdir(parents=True, exist_ok=True)
        if self.target_root.is_symlink():
            log(f"Re-pointing targets/{self.name} -> {destination}")
            self.target_root.unlink()
        elif self.target_root.exists():
            raise ValueError(f"targets/{self.name} already exists and is not a symlink")
        self.target_root.symlink_to(destination, target_is_directory=True)
        log(f"Symlinking targets/{self.name} -> {destination} (local non-VCS source; not cloned, pulled, or fetched)")

    def clone(self, repo_type: str) -> None:
        self.target_root.parent.mkdir(parents=True, exist_ok=True)
        log(f"Cloning {repo_type} source into targets/{self.name}")
        if repo_type == "git":
            run(["git", "clone", self.source, str(self.target_root)])
            if self.args.ref:
                run(["git", "-C", str(self.target_root), "checkout", self.args.ref])
        else:
            command = ["hg", "clone"]
            if self.args.ref:
                command.extend(("-u", self.args.ref))
            run([*command, self.source, str(self.target_root)])

    def blocked_by_local_edits(self) -> bool:
        """True when tracked edits an update would clobber are present.

        Untracked paths — sanitizer build trees, .audit overlays, leftover run
        logs — are not source and never obstruct a fast-forward, so a checkout
        carrying only those still updates. Shared with the freshness signature
        so both read one VCS policy, git and hg alike.
        """
        changed = target_config.source_changed_paths(self.target_root, include_untracked=False)
        if not changed:
            return False
        shown = ", ".join(changed[:3])
        if len(changed) > 3:
            shown += f", +{len(changed) - 3} more"
        log(f"targets/{self.name} has tracked local changes ({shown}); leaving source checkout untouched")
        return True

    def sync_git(self) -> None:
        if self.blocked_by_local_edits():
            return
        log(f"Fetching git updates for targets/{self.name}")
        if self.args.ref:
            fetched = subprocess.run(["git", "-C", str(self.target_root), "fetch", "--tags", "origin", self.args.ref])
            if fetched.returncode:
                run(["git", "-C", str(self.target_root), "fetch", "--tags", "origin"])
            run(["git", "-C", str(self.target_root), "checkout", self.args.ref])
        else:
            run(["git", "-C", str(self.target_root), "fetch", "--tags", "origin"])
        upstream = subprocess.run(["git", "-C", str(self.target_root), "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if upstream.returncode == 0:
            run(["git", "-C", str(self.target_root), "pull", "--ff-only"])
        else:
            log("No upstream tracking branch; fetched updates without changing HEAD")

    def sync_hg(self) -> None:
        if self.blocked_by_local_edits():
            return
        log(f"Pulling hg updates for targets/{self.name}")
        run(["hg", "--cwd", str(self.target_root), "pull"])
        command = ["hg", "--cwd", str(self.target_root), "update"]
        if self.args.ref:
            command.extend(("-r", self.args.ref))
        run(command)

    def seed_config(self) -> None:
        self.config_dir.mkdir(parents=True, exist_ok=True)
        parsed: dict = {}
        if not self.toml.is_file():
            reason = "missing"
        else:
            try:
                parsed = target_config.parse_toml(self.toml)
            except Exception:
                reason = "invalid"
            else:
                reason = (
                    "requested" if self.args.force else
                    "placeholders" if target_config.config_has_live_placeholder(
                        self.toml, self.target_root
                    ) else ""
                )
        keep_for_build = self.args.build and reason in (
            "placeholders", "requested"
        )
        if (
            reason in ("", "placeholders") or keep_for_build
        ) and self.args.browser is not None:
            if not parsed:
                parsed = target_config.parse_toml(self.toml)
            current = str(parsed.get("is_browser", "0")).lower() in {
                "1", "true",
            }
            if current != self.args.browser:
                target_config.update_browser_mode(self.toml, self.args.browser)
                log(
                    f"Updated output/{self.name}/target.toml browser mode to "
                    f"{1 if self.args.browser else 0}"
                )
        if keep_for_build:
            log(f"Keeping output/{self.name}/target.toml as-is (--build does not re-seed; run 'bin/setup-target {self.name}' without --build to regenerate it)")
            return
        if not reason:
            log(f"Keeping reviewed output/{self.name}/target.toml (pass --force to regenerate)")
            return
        if reason == "placeholders":
            log(f"Refreshing output/{self.name}/target.toml to fill placeholders (preserving curated [threat_model] / [s6_peers])")
            target_config.seed_toml(
                self.target_root, self.toml, self.source,
                preserve_curated=True, browser_mode=self.args.browser,
                target_slug=self.name,
            )
            return
        if reason == "missing":
            log(f"Seeding output/{self.name}/target.toml")
        elif reason == "invalid":
            log(f"Refreshing output/{self.name}/target.toml because it no longer parses as TOML")
        else:
            log(f"Regenerating output/{self.name}/target.toml (--force)")
        # Carry the curated sections across even here. A full re-seed drops
        # what it cannot re-derive and leaves restoring it to the LLM helpers
        # below, which makes every reason they do not run — `--no-llm-config`,
        # a disabled bootstrap, or simply every backend failing — a silent
        # deletion of an operator's threat model and peer set. Preserving costs
        # nothing when they do run: both are invoked with `--force` on this
        # path and overwrite what they derive. `missing` and `invalid` reach
        # the same call with nothing to carry, and preserving is a no-op there.
        target_config.seed_toml(
            self.target_root, self.toml, self.source,
            preserve_curated=True, browser_mode=self.args.browser,
            target_slug=self.name,
        )
        self.seeded_full = True

    def backend_candidates(self) -> list[str]:
        requested = os.environ.get("ACTIVE_BACKEND", os.environ.get("BACKEND", os.environ.get("AUDIT_BACKEND", "")))
        result: list[str] = []
        for candidate in ([requested] if requested and requested != "all" else []) + ["claude", "codex", "gemini", "grok"]:
            if candidate and candidate not in result:
                result.append(candidate)
        if requested == "oss" or os.environ.get("MODEL", os.environ.get("AUDIT_MODEL", "")):
            result.append("oss")
        return result

    def run_config_helper(self, helper: str, helper_args: list[str]) -> None:
        executable = SCRIPT_ROOT / "bin" / helper
        if not os.access(executable, os.X_OK):
            return
        candidates = self.backend_candidates()
        for index, backend in enumerate(candidates):
            environment = {
                **os.environ, "SCRIPT_ROOT": str(SCRIPT_ROOT),
                "ACTIVE_BACKEND": backend, "BACKEND": backend,
                "LLM_BOOTSTRAP_QUIET": "1",
            }
            completed = subprocess.run(
                [str(executable), *helper_args], env=environment
            )
            if completed.returncode == 0:
                log(
                    f"config bootstrap: {helper} succeeded on "
                    f"backend={backend} - updated output/{self.name}/target.toml"
                )
                return
            if completed.returncode == 4:
                log(
                    f"config bootstrap: {helper} kept the existing curated "
                    f"section on backend={backend}"
                )
                return
            next_backend = candidates[index + 1] if index + 1 < len(candidates) else ""
            if next_backend:
                log(
                    f"config bootstrap: {helper} returned "
                    f"rc={completed.returncode} on backend={backend} - "
                    f"retrying with backend={next_backend}"
                )
            else:
                log(
                    f"config bootstrap: {helper} returned "
                    f"rc={completed.returncode} on backend={backend} - "
                    "no remaining backends"
                )

    def llm_bootstrap(self) -> None:
        if not self.seeded_full:
            return
        if self.args.no_llm_config or os.environ.get("AUDIT_NEW_TARGET_BOOTSTRAP", "1") == "0" or os.environ.get("LLM_DECIDE_DISABLE", "0") == "1":
            return
        for helper in ("suggest-threat-model", "suggest-peers"):
            helper_args = [self.name, "--apply"]
            if helper == "suggest-threat-model" or self.args.force:
                helper_args.append("--force")
            self.run_config_helper(helper, helper_args)

    def runner_bootstrap(self) -> None:
        """Derive native CLI argv after the sanitizer build is selectable."""
        if (
            self.args.no_llm_config
            or os.environ.get("AUDIT_NEW_TARGET_BOOTSTRAP", "1") == "0"
            or os.environ.get("LLM_DECIDE_DISABLE", "0") == "1"
        ):
            return
        config = target_config.Config(target_root=str(self.target_root))
        target_config.load_toml_into(config, self.toml)
        raw_runner = target_config.parse_toml(self.toml).get("runner", {})
        runner_is_calibrated = (
            isinstance(raw_runner, dict) and "success_codes" in raw_runner
        )
        if (
            str(config.is_browser).lower() in {"1", "true"}
            or config.build_system not in target_config.NATIVE_BUILD_SYSTEMS
            or config.runner_bin
            or (
                config.runner_args and runner_is_calibrated
                and (not self.args.force or self.args.build)
            )
        ):
            return
        if config.first_executable_sanitizer() is None:
            return
        helper_args = [self.name, "--apply"]
        if self.args.force:
            helper_args.append("--force")
        self.run_config_helper("suggest-runner", helper_args)

    def language_build(self, config: target_config.Config) -> None:
        language = (
            languages.for_build_system(config.build_system)
            if config.build_system
            else None
        )
        if not self.args.build and language and language.name == "python":
            stale = languages.stale_python_extensions(self.target_root)
            if stale:
                log(f"ABI mismatch: {len(stale)} Python extension(s) built for a non-active interpreter - forcing a build")
                self.args.build = True
        if not self.args.build or not config.build_system:
            return
        if not language:
            log(f"bootstrap: skipped (build_system='{config.build_system}' is not registered in lib/languages.py)")
            return
        plan = languages.bootstrap_plan_for_target(self.target_root, config.build_system)
        if not plan.get("cmds"):
            return
        audit_dir = self.target_root / ".audit"
        refusal = (
            f"bootstrap refused for {self.name}: the configured runner "
            "is in use by another audit or benchmark"
        )
        lease = (
            build_lease.exclusive(
                self.target_root, build_lease.RUNNER_LEASE_NAME,
                timeout=0,
            )
            if config.runner_bin
            else contextlib.nullcontext(True)
        )
        with lease as acquired:
            if not acquired:
                raise RuntimeError(refusal)
            status = languages.execute_bootstrap_plan(
                self.target_root, plan, audit_dir / "bootstrap.log",
                audit_dir / "bootstrap.sh",
            )
        if status:
            raise RuntimeError(f"bootstrap failed for {self.name} (see {audit_dir / 'bootstrap.log'})")

    def require_launchable(
        self, config: target_config.Config, binary: Path, sanitizer_name: str,
    ) -> None:
        """Reject a sanitizer executable that dies in the loader before main().

        An executable file is not yet a selectable artifact. Probed under the
        target's own ``[runner].env``, so one that fails here fails under
        bin/probe too and every run it serves returns NO_EXEC. No argv the
        runner inference could derive repairs it; the build recipe can, and
        this is the last point where that repair still runs.
        """
        failure = runner_preflight.probe_startup(
            binary, config, sanitizer_name
        )
        if failure:
            raise RuntimeError(
                f"sanitizer executable {binary} failed before program "
                f"startup:\n{failure}"
            )

    def require_reachable_runner(self, config: target_config.Config) -> None:
        """Prove the seeded [runner] reaches the target it was written for.

        Only after `--build`: until the recipe has run there is nothing to
        reach, and an R package installs into the target-local library the
        seeded runner points at. The check is the one an audit runs, so a
        target that passes here is one bin/audit will accept.
        """
        if not self.args.build:
            return
        fresh = target_config.Config(
            slug=self.name, target_root=str(self.target_root),
            results_dir=str(self.toml.parent / "preflight" / "results"),
        )
        try:
            target_config.load_toml_into(fresh, self.toml)
        except (OSError, ValueError):
            return
        skipped = runner_canary.skip_reason(fresh)
        if skipped:
            log(f"Runner reachability: not checked ({skipped})")
            return
        unreachable = runner_canary.check(fresh)
        if unreachable:
            raise RuntimeError(
                f"the seeded [runner] cannot reach {self.name}: {unreachable}"
            )
        log(f"Runner reachability OK: a testcase reaches {self.target_root}")

    def report_invariant_runners(self) -> None:
        """Say when a configured runner's behaviour never varies with its input.

        Such a binary can make `bin/run-<san> generic` report CLEAN whatever it
        is given, so a crash that reproduces by hand is recorded as gone. The
        probe that would have caught it only ever ran on *candidate* programs
        at seed time, never on the value already in the file.

        Diagnostic only, and deliberately so. Neither answer is proof: exit
        status and output are all a portable probe sees, so a program that only
        stat()s the path varies with it while never opening it, and a parser
        that reads its input silently does not vary at all while still
        crashing on a crafted testcase. Choosing a replacement is a semantic
        judgement about which program is the project's input boundary rather
        than a test driver, a benchmark or an internal tool, and neither this
        probe nor the free executable scan can make it.

        It runs here, after the builds and the runner bootstrap, so it reads
        the configuration the audit will actually use — including a binary
        outside the build tree, and one this same pass just selected.
        """
        if not self.toml.is_file():
            return
        config = target_config.Config(
            slug=self.name, target_root=str(self.target_root),
        )
        try:
            target_config.load_toml_into(config, self.toml)
        except (OSError, ValueError):
            return
        if str(config.is_browser).lower() in {"1", "true"}:
            return
        for name in config.sanitizers_enabled or ["asan"]:
            if sanitizer.generic_skips_testcase(name, os.environ):
                continue
            configured = config.sanitizer_bin(name)
            if not configured or "FILL_ME" in configured:
                continue
            binary = Path(config.resolve_path(configured))
            # bin/probe applies the argv template to a sanitizer binary only
            # when no separate runner owns the invocation. Probing any other
            # argv would judge a command the harness never runs.
            args = (
                list(config.runner_args)
                if config.runner_args and not config.runner_bin
                else ["{TESTCASE}"]
            )
            if runner_preflight.testcase_verdict(
                binary, args, runner_preflight.runner_environment(config, name),
            ) != runner_preflight.OBSERVABLY_INVARIANT:
                continue
            log(
                f"WARN: {name}_bin {binary.name} produced the same exit status "
                f"and output for a present and a missing testcase. That does "
                f"not prove it ignores its input — a parser may read quietly — "
                f"but a runner that truly ignores it reports CLEAN whatever "
                f"the input, so confirm it consumes testcase contents. To "
                f"reselect: bin/suggest-runner {self.name} --apply --force"
            )

    def sanitizer_build_artifact_present(
        self,
        config: target_config.Config,
        sanitizer_name: str,
        build_dir: Path,
    ) -> bool:
        """Verify a recipe produced a selectable artifact in its clean tree."""
        is_browser = config.is_browser in ("1", "true", "True")

        def configured_in_tree(configured: str) -> Path | None:
            if not configured or "FILL_ME" in configured:
                return None
            try:
                path = Path(config.resolve_path(configured))
                path.resolve().relative_to(build_dir.resolve())
            except (OSError, ValueError):
                return None
            return path

        # bin/probe selects a configured executable ahead of any library
        # harness route. If that exact in-tree file vanished or lost +x, a
        # surviving library must not make the same build count as usable.
        configured_bin = configured_in_tree(
            config.sanitizer_bin(sanitizer_name)
        )
        if configured_bin is not None:
            if not configured_bin.is_file() or not os.access(
                configured_bin, os.X_OK
            ):
                return False
            # A browser is launched through its own product layout, not a CLI
            # help probe, so it is exempt from the startup check.
            if not is_browser:
                self.require_launchable(
                    config, configured_bin, sanitizer_name
                )
            return True

        configured_lib = configured_in_tree(
            config.sanitizer_lib(sanitizer_name)
        )
        if configured_lib is not None and configured_lib.is_file():
            return True
        if is_browser:
            if self.profile is not None and self.profile.browser_bin:
                product = build_dir / self.profile.browser_bin
                return product.is_file() and os.access(product, os.X_OK)
            return bool(
                target_config.detect_browser_sanitizer_bin(
                    self.target_root, sanitizer_name
                )
            )
        detected_bin, detected_lib = \
            target_config.detect_sanitizer_build_artifacts(
                self.target_root, sanitizer_name
            )
        # Detection feeds <san>_bin below, so an unlaunchable detected program
        # becomes the probe route even when a library was also produced.
        if detected_bin:
            self.require_launchable(
                config, Path(config.resolve_path(detected_bin)), sanitizer_name
            )
        if detected_bin or detected_lib:
            return True
        return (
            config.build_system == "cmake"
            and target_config.cmake_build_is_header_only(build_dir)
        )

    def sanitizer_builds(self, config: target_config.Config) -> None:
        audit_dir = self.target_root / ".audit"
        # Native C/C++ trees converge a .audit/build.sh through auto-build-script;
        # a language target (cargo/go/pip) opts into a sanitizer build only by
        # shipping a hand-authored .audit/build.sh (or build-<san>.sh) recipe.
        # With neither a native build system nor such a recipe there is nothing
        # to materialize.
        primary_recipe = target_config.build_recipe_path(self.target_root, "asan")
        has_recipe = primary_recipe.is_file() or any(
            target_config.build_recipe_path(self.target_root, name).is_file()
            for name in ("ubsan", "msan", "tsan")
        )
        if (
            config.build_system not in target_config.NATIVE_BUILD_SYSTEMS
            and not has_recipe
        ):
            return
        if config.sanitizers_explicitly_disabled:
            sanitizers = []
        else:
            sanitizers = ["asan", *(
                name for name in config.sanitizers_enabled if name != "asan"
            )]
        if self.args.build:
            candidates = self.backend_candidates()
            auto_builder = SCRIPT_ROOT / "bin/auto-build-script"
            build_errors: list[str] = []
            for sanitizer_name in sanitizers:
                if sanitizer_name not in {"asan", "ubsan", "msan", "tsan"}:
                    continue
                recipe = target_config.build_recipe_path(
                    self.target_root, sanitizer_name
                )
                candidate_dir = audit_dir / "build-candidates"
                candidate = candidate_dir / f"{recipe.name}.{os.getpid()}"
                candidate.unlink(missing_ok=True)
                generated = False
                if recipe.is_file():
                    if self.args.force:
                        log(
                            f"bootstrap: using existing {recipe} "
                            "(--force rebuilds its output)"
                        )
                    else:
                        log(f"bootstrap: keeping existing {recipe}")
                elif os.access(auto_builder, os.X_OK):
                    candidate_dir.mkdir(parents=True, exist_ok=True)
                    environment = {**os.environ, "SCRIPT_ROOT": str(SCRIPT_ROOT)}
                    if candidates:
                        environment.update(
                            ACTIVE_BACKEND=candidates[0], BACKEND=candidates[0]
                        )
                    completed = subprocess.run([
                        str(auto_builder), "--src", str(self.target_root),
                        "--out", str(candidate), "--sanitizer", sanitizer_name,
                        "--emit-initial",
                    ], env=environment)
                    if completed.returncode == 0:
                        generated = True
                        log(
                            f"bootstrap: generated deterministic {sanitizer_name} "
                            "recipe - validating it in the canonical clean build"
                        )
                    else:
                        log(
                            f"bootstrap: no deterministic {sanitizer_name} "
                            f"recipe is available for build_system={config.build_system}"
                        )
                active_recipe = candidate if generated else recipe
                if not active_recipe.is_file():
                    build_errors.append(
                        f"{sanitizer_name} build has no usable recipe for "
                        f"build_system={config.build_system}"
                    )
                    continue
                build_dir = self.target_root / f"build-{sanitizer_name}{os.environ.get('AUDIT_BUILD_SUFFIX', '')}"
                freshness = target_config.build_freshness(
                    self.target_root, sanitizer_name, recipe_path=recipe
                )
                # Existing recipes still need the materializer's launch check:
                # a content-fresh tree can lose a host shared dependency.
                # A newly generated candidate must not replace a healthy tree
                # merely because setup happened to generate it concurrently.
                if freshness != "fresh" or self.args.force or not generated:
                    if freshness == "fresh" and not self.args.force:
                        log(
                            f"bootstrap: verifying {sanitizer_name} build "
                            f"startup in {build_dir}"
                        )
                    else:
                        log(f"bootstrap: materializing {sanitizer_name} build into {build_dir} (source is {freshness}; compiling so <san>_bin/<san>_lib can be detected; a few minutes)")
                    audit_dir.mkdir(parents=True, exist_ok=True)
                    # A committed or hand-authored recipe may lose its executable
                    # bit. Restore only owner-execute; do not broaden its access.
                    active_recipe.chmod(active_recipe.stat().st_mode | 0o100)
                    result = build_materialize.materialize(
                        self.target_root,
                        sanitizer_name,
                        active_recipe,
                        recipe,
                        lambda tree: self.sanitizer_build_artifact_present(
                            config, sanitizer_name, tree
                        ),
                        force=self.args.force,
                    )
                    if result.status == "built":
                        log(f"bootstrap: {sanitizer_name} build complete")
                    else:
                        if result.status == "fresh":
                            candidate.unlink(missing_ok=True)
                            continue
                        if result.status == "held":
                            # Not a build failure: declining to replace a tree a
                            # live run is reading is the designed outcome, and
                            # parallel audits hit it routinely. Reporting it as
                            # an error would make the exit code depend on who
                            # else is running.
                            log(
                                f"bootstrap: {sanitizer_name} build not replaced "
                                f"({result.reason}); the existing tree stays in "
                                f"place for the run that is using it"
                            )
                            candidate.unlink(missing_ok=True)
                            continue
                        log(
                            f"bootstrap: {sanitizer_name} clean build failed "
                            f"({result.reason}; see {result.log_path})"
                        )
                        # Existing recipes used to get only one materialization
                        # attempt. A clean failure is the evidence needed for a
                        # bounded repair loop; keep the old recipe/build until a
                        # revised candidate passes both scratch and canonical
                        # validation.
                        repaired_ok = False
                        if (
                            not self.args.no_llm_config
                            and os.environ.get("LLM_DECIDE_DISABLE", "0") != "1"
                            and os.access(auto_builder, os.X_OK)
                            and candidates
                            and result.log_path is not None
                        ):
                            candidate_dir.mkdir(parents=True, exist_ok=True)
                            repaired = candidate_dir / f"{recipe.name}.{os.getpid()}.repaired"
                            repaired.unlink(missing_ok=True)
                            for backend in candidates:
                                repaired.unlink(missing_ok=True)
                                environment = {
                                    **os.environ,
                                    "SCRIPT_ROOT": str(SCRIPT_ROOT),
                                    "ACTIVE_BACKEND": backend,
                                    "BACKEND": backend,
                                }
                                completed = subprocess.run([
                                    str(auto_builder), "--src", str(self.target_root),
                                    "--out", str(repaired),
                                    "--sanitizer", sanitizer_name,
                                    "--repair-from", str(active_recipe),
                                    "--failure-log", str(result.log_path),
                                    "--max-iters", "3",
                                ], env=environment, check=False)
                                if completed.returncode or not repaired.is_file():
                                    continue
                                repaired_result = build_materialize.materialize(
                                    self.target_root,
                                    sanitizer_name,
                                    repaired,
                                    recipe,
                                    lambda tree: self.sanitizer_build_artifact_present(
                                        config, sanitizer_name, tree
                                    ),
                                    force=self.args.force,
                                )
                                if repaired_result.status == "built":
                                    repaired_ok = True
                                    log(
                                        f"bootstrap: repaired {sanitizer_name} "
                                        "recipe after clean-build failure on "
                                        f"backend={backend}"
                                    )
                                    break
                                repaired.unlink(missing_ok=True)
                        candidate.unlink(missing_ok=True)
                        if not repaired_ok:
                            build_errors.append(
                                f"{sanitizer_name} build failed: {result.reason}"
                            )
                elif generated:
                    # A concurrent materializer may have made the old recipe
                    # fresh while this candidate was generated. Do not replace
                    # that recipe without validating this candidate against the
                    # canonical tree.
                    candidate.unlink(missing_ok=True)
        elif sanitizers and not primary_recipe.is_file():
            log(f"hint: {self.name} is a {config.build_system} target with no {primary_recipe} yet; bin/audit builds it automatically")
        preferred_browser_bins = {}
        if (
            self.profile is not None
            and self.profile.browser_bin
            and config.is_browser in ("1", "true", "True")
        ):
            # Bound to the product on disk, not to build freshness: a stale
            # tree is exactly where the generic detector is least able to pick
            # the full product out of an ambiguous build, so withholding the
            # curated path there would install the worse answer.
            for sanitizer_name in sanitizers:
                relative = (
                    f"build-{sanitizer_name}/"
                    f"{self.profile.browser_bin}"
                )
                candidate = Path(config.resolve_path(relative))
                if candidate.is_file() and os.access(candidate, os.X_OK):
                    preferred_browser_bins[sanitizer_name] = relative
        if target_config.refresh_detected_build_fields(
            self.target_root,
            self.toml,
            is_browser=config.is_browser in ("1", "true", "True"),
            preferred_browser_bins=preferred_browser_bins,
        ):
            log(f"Refreshed <san>_bin/<san>_lib in {self.toml} from build trees on disk")
        # Persist every sanitizer that completed before reporting a later
        # failure, so retrying does not discard usable build output.
        if self.args.build and build_errors:
            raise RuntimeError("; ".join(build_errors))

        # Keep build-asan as the regular control, then materialize cached ASan
        # alternates. Alternate failure is intentionally additive/fail-open.
        build_configs_command = SCRIPT_ROOT / "bin" / "build-configs"
        if (
            self.args.build and not self.args.no_alternates
            and config.build_configs and os.access(build_configs_command, os.X_OK)
        ):
            candidates = self.backend_candidates()
            command = [
                str(build_configs_command),
                "--target-path", str(self.target_root),
                "--target-toml", str(self.toml), "--all",
            ]
            if candidates:
                command += ["--backend", candidates[0]]
            if self.args.force:
                command.append("--force")
            environment = os.environ.copy()
            if candidates:
                environment.update(ACTIVE_BACKEND=candidates[0], BACKEND=candidates[0])
            completed = subprocess.run(command, env=environment, check=False)
            if completed.returncode:
                log("bootstrap: alternate build configurations could not be prepared; primary build is unaffected")

    def report_harness_input_mismatch(self) -> None:
        """Repair, or report, a library and include set that cannot see each other.

        The CLI route is proved by launching the program, and a binary that
        cannot start is re-detected and replaced. The library route was proved
        by `is_file()`, which a helper archive beside the product passes just as
        well, and `includes` was never re-checked at all — so a pair that
        declares nothing survived every rerun. Downstream that reads as "this
        target has no API", which is also what a target with no API looks like.

        Generic artifact ranking is not enough to overrule an operator-selected
        library. Zero overlap proves only that the configured pair cannot expose
        a C API. Try the detected public headers against that same library and
        repair `includes` when they agree; otherwise retain the configuration
        and report the unresolved route instead of auditing a nearby helper.
        """
        for sanitizer_name in self.harness_input_sanitizers():
            config = target_config.Config(target_root=str(self.target_root))
            target_config.load_toml_into(config, self.toml)
            exported, declared = self.declared_exports(config, sanitizer_name)
            if not exported or declared:
                continue
            _, includes = target_config.detected_harness_inputs(
                self.target_root, sanitizer_name,
            )
            configured_library = config.sanitizer_lib(sanitizer_name)
            candidate = target_config.Config(target_root=str(self.target_root))
            target_config.load_toml_into(candidate, self.toml)
            repaired_includes = list(dict.fromkeys([*config.includes, *includes]))
            candidate.includes = repaired_includes
            _, repaired = self.declared_exports(candidate, sanitizer_name)
            if repaired:
                before = self.toml.read_text(encoding="utf-8")
                after = target_config.set_harness_includes(
                    before, repaired_includes,
                )
                if after != before:
                    self.toml.write_text(after, encoding="utf-8")
                    log(
                        "Repaired harness inputs (kept the configured library, "
                        f"repaired includes): configured pair "
                        f"declared none of the library's {exported} exported "
                        f"symbol(s); {configured_library} + {repaired_includes} "
                        f"declares {repaired}"
                    )
                    continue
                log(
                    f"WARN: {sanitizer_name}_lib/includes declared none of the "
                    f"library's {exported} exported symbol(s); {configured_library} + "
                    f"{repaired_includes} declares {repaired}, but target.toml "
                    "carries no active top-level `includes` array to repair"
                )
                continue
            log(
                f"WARN: {sanitizer_name}_lib exports {exported} symbol(s) that "
                f"`includes` does not declare, and the detected include set "
                f"still exposes none of them; a C harness cannot be written "
                f"against this target. "
                f"Check that {sanitizer_name}_lib names the library the build "
                f"publishes rather than a helper archive beside it, and that "
                f"`includes` reaches its public headers"
            )

    def harness_input_sanitizers(self) -> "list[str]":
        config = target_config.Config(target_root=str(self.target_root))
        target_config.load_toml_into(config, self.toml)
        # Browser setup deliberately does not detect or refresh a link library:
        # its proved product route is the page/script runner, and a browser
        # build contains thousands of unrelated native archives. Treating an
        # old or curated browser library as a generic C API would both diagnose
        # the wrong contract and scan an enormous symbol/header surface.
        if config.is_browser in ("1", "true", "True"):
            return []
        return [
            name for name in config.sanitizers_enabled
            if name in {"asan", "ubsan", "msan", "tsan"}
            and config.sanitizer_lib(name)
        ]

    @staticmethod
    def declared_exports(config, sanitizer_name: str) -> "tuple[int, int]":
        try:
            return fuzz_harness.declared_exports(config, sanitizer_name)
        except (OSError, ValueError):
            return 0, 0

    def execute(self) -> int:
        self.prepare_source()
        self.seed_profile_build_recipe()
        self.seed_config()
        self.llm_bootstrap()
        target_config.parse_toml(self.toml)
        revision = target_config.detect_rev(self.target_root)
        log(f"Source: {self.target_root}")
        log(f"Config: {self.toml}")
        if revision:
            log(f"Revision: {revision}")
        config = target_config.Config(target_root=str(self.target_root))
        target_config.load_toml_into(config, self.toml)
        self.language_build(config)
        self.sanitizer_builds(config)
        self.runner_bootstrap()
        self.report_invariant_runners()
        self.require_reachable_runner(config)
        self.report_harness_input_mismatch()
        print(f"\nNext steps:\n  1. Review output/{self.name}/target.toml.\n  2. Smoke-test with: bin/audit --target {self.requested_name} --backend <claude|codex|gemini|grok|oss> 1")
        return 0


def main(argv: list[str] | None = None) -> int:
    try:
        return Setup(parse_args(sys.argv[1:] if argv is None else argv)).execute()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as exc:
        print(f"[setup-target] FATAL: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
