#!/usr/bin/env python3
"""Run a testcase under SanitizerCoverage and report symbol reachability."""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import hashlib
import os
import platform
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import traceback
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import coverage_build
import edges
import fuzz_harness
import languages
import sanitizer
import sanitizer_run
import target_config
from timeout import TIMEOUT_RC, run_timeout

# Sibling build trees a native testcase can be replayed against for coverage.
# `+fuzz` is the SanitizerCoverage sibling bin/setup-target builds beside the
# primary; `+cov` is an accepted alias for a hand-built one. ASan's
# `coverage=1` .sancov dump needs the trace-pc-guard __sancov_guards section,
# so the same sibling serves both libFuzzer's campaign and this probe. A
# sibling that exists but lacks the section is skipped at selection time so
# coverage reports unavailable (never a miss, never a hard error), rather than
# being chosen and then rejected by probe_sancov.
GENERIC_COVERAGE_SUFFIXES = coverage_build.ACCEPTED_SUFFIXES

# `atos -fullPath` answers one line per address: `symbol (in module) (file:line)`.
# Anything else — a bare address, a symbol with no source behind it — resolved
# no source location and contributes no coverage edge.
ATOS_ANSWER_RE = re.compile(r"^(?P<function>.+?) \(in [^)]*\) \((?P<location>.+:\d+)\)$")

NOISE_RE = re.compile(
    r"ne_context_new|cubeb_|nrappkit|nspr|nss_init|sqlite3|^ld-|^dyld_|gmp_|"
    r"dns_init|libsystem_|CoreFoundation|NSApplication|XPCOMGlueLoad|nsAppRunner|"
    r"NS_LogInit|InitGlobalCallback|GeckoMain|XRE_main$|loadXULBundle|"
    r"MOZ_NewProcessBinding"
)
PROFILE_PREFS = '''user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("dom.allow_scripts_to_close_windows", true);
user_pref("devtools.console.stdout.content", true);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.startup.page", 0);
'''


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--testcase", required=True)
    result.add_argument("--want", required=True)
    result.add_argument("--mode", choices=("browser", "js", "generic"), default="browser")
    result.add_argument("--timeout", type=int, default=20)
    result.add_argument("--save")
    result.add_argument("--log")
    result.add_argument(
        "--route-binary", default="",
        help="generic-mode binary selected by the caller; coverage falls open "
             "when it is not the configured ASan CLI",
    )
    result.add_argument(
        "--harness-source", default="",
        help="generic-mode C/C++ harness source bin/probe compiled for the "
             "route; coverage replays a twin of it linked against the "
             "coverage sibling's library",
    )
    result.add_argument(
        "--generic-skip-testcase", action="store_true",
        help="generic-mode argv already contains the testcase",
    )
    result.add_argument("--slug", default=os.environ.get("TARGET_SLUG", ""))
    result.add_argument("--agent", default=os.environ.get("AUDIT_AGENT_NUM", os.environ.get("AGENT_NUM", "0")))
    result.add_argument("extra", nargs=argparse.REMAINDER)
    return result


def llvm_tool(name: str, override: str = "") -> str:
    return override or sanitizer.llvm_tool(name)


def stat_key(path: Path) -> str:
    stat = path.stat()
    return f"{path}:{int(stat.st_mtime)}:{stat.st_size}"


def cache_dir() -> Path:
    base = os.environ.get("RESULTS_DIR", os.environ.get("LOGDIR", ""))
    if base:
        result = Path(base) / ".hits-cache"
    else:
        result = Path(tempfile.gettempdir()) / f"audit-hits-cache-{os.environ.get('USER', 'user')}"
    result.mkdir(parents=True, exist_ok=True)
    return result


def has_sancov_section(binary: Path) -> bool:
    """Guard check for selecting a coverage sibling; never raises."""
    try:
        present, _ = coverage_build.sancov_section_present(Path(binary))
    except OSError:
        return False
    return present


_SHARED_OBJECT_RE = re.compile(r"\.(?:dylib|so)(?:\.\d+)*$")

_DEFINITION_RE = re.compile(
    r"(?m)^[^\n;#]*?\b([A-Za-z_]\w*)\s*\([^;{}]*\)\s*(?:const\s*)?\{")


def _defined_functions(source: Path) -> set[str]:
    """Function names a C/C++ source defines (not merely calls)."""
    try:
        text = source.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return set()
    return set(_DEFINITION_RE.findall(text))


def probe_sancov(label: str, binary: Path) -> None:
    key_text = stat_key(binary)
    cache = cache_dir() / f"sancov-{hashlib.sha1(key_text.encode()).hexdigest()}.ok"
    if cache.is_file() and cache.stat().st_size:
        return
    present, diagnostic = coverage_build.sancov_section_present(binary)
    if not present:
        raise RuntimeError(f"{label}: {diagnostic}")
    cache.write_text(key_text + "\n")


class Hits:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.testcase = Path(args.testcase)
        if not self.testcase.is_file():
            raise ValueError(f"testcase not found: {self.testcase}")
        try:
            self.want = re.compile(args.want)
        except re.error as exc:
            raise ValueError(f"invalid --want regex: {exc}") from exc
        try:
            self.config = target_config.load(self.testcase)
        except (FileNotFoundError, ValueError):
            self.config = None
        self.target_root = Path(self.config.target_root if self.config else os.environ.get("TARGET_ROOT", ROOT / "targets/firefox"))
        self.asan_build = sanitizer.build_dir("asan", str(self.target_root))
        self.build = sanitizer.build_dir("asan-cov", str(self.target_root))
        self.app = Path(os.environ.get("COV_APP", self.build / "dist/Nightly.app"))
        self.browser = Path(os.environ.get("COV_BROWSER", self._browser_from_config()))
        self.xul = Path(os.environ.get("COV_XUL", self._default_xul()))
        self.js = Path(os.environ.get("COV_JS", self.build / "dist/bin/js"))
        self.sancov = Path(llvm_tool("sancov", os.environ.get("SANCOV", "")))
        self.symbolizer = Path(llvm_tool("llvm-symbolizer", os.environ.get("SYMBOLIZER", "")))
        self.edge_count = 0
        self.new_edges = 0
        self.generic_binary: Path | None = None
        self.generic_tree: Path | None = None
        self.generic_reason = ""
        # Set by the generic replay; browser/js keep their own deadlines.
        self.deadline_hit = False
        # Set when the symbolizer itself was killed at its deadline.
        self.symbolize_timed_out = False
        # When generic_binary is a coverage twin of a probe harness rather than
        # the configured CLI, the harness source it was compiled from: the twin
        # takes the harness's argv shape, and frames from that file are the
        # harness's own, not target coverage.
        self.harness_twin: Path | None = None
        if args.mode == "generic":
            self.generic_binary, self.generic_tree, self.generic_reason = (
                self._resolve_generic()
            )

    def _resolve_generic(self) -> tuple[Path | None, Path | None, str]:
        """The target's configured binary inside an instrumented sibling tree.

        The audit drives a native testcase through the plain ``build-<san>``
        binary; coverage needs the same binary rebuilt with SanitizerCoverage,
        which lives in a sibling tree pruned from build freshness. Returns the
        binary, its sibling tree root, and — when neither sibling carries it —
        the reason, so coverage can be reported unavailable rather than as a
        miss.
        """
        raw = self.config.sanitizer_bin("asan") if self.config else ""
        plain = Path(self.config.resolve_path(raw)) if raw else None
        route_text = self.args.route_binary or os.environ.get("ASAN_GENERIC_BIN", "")
        if route_text:
            route = Path(route_text)
            same_route = False
            if plain is not None:
                try:
                    same_route = os.path.samefile(route, plain)
                except OSError:
                    same_route = os.path.realpath(route) == os.path.realpath(plain)
            if not same_route:
                # A library-only target has no CLI at all; its harness route
                # is the only one, and the twin below is its coverage build.
                if self.args.harness_source:
                    return self._resolve_harness_twin(
                        Path(self.args.harness_source), self.asan_build.name,
                    )
                return None, None, (
                    f"active sanitizer route {route} is not the configured ASan CLI "
                    f"{plain or '(none configured)'}; no route-equivalent coverage "
                    f"sibling is available"
                )
        if plain is None:
            return None, None, "target.toml has no asan_bin to instrument for coverage"
        plain_tree = self.asan_build.name
        present_without_guards: list[str] = []
        stale_reasons: list[str] = []
        for suffix in GENERIC_COVERAGE_SUFFIXES:
            sibling_tree = plain_tree + suffix
            candidate = Path(
                str(plain).replace(f"/{plain_tree}/", f"/{sibling_tree}/", 1)
            )
            if str(candidate) == str(plain) or not os.access(candidate, os.X_OK):
                continue
            # A sibling without __sancov_guards would dump no .sancov; skip it
            # here so coverage reports unavailable cleanly instead of being
            # picked and then raising in validate() (which the gate would read
            # as an env failure, not as coverage-unavailable).
            if has_sancov_section(candidate):
                stale = coverage_build.stale_reason(self.target_root, "asan", suffix)
                if stale:
                    stale_reasons.append(stale)
                    continue
                return candidate, self.target_root / sibling_tree, ""
            present_without_guards.append(sibling_tree)
        if stale_reasons:
            return None, None, stale_reasons[0]
        if present_without_guards:
            return None, None, (
                f"sibling build {' and '.join(present_without_guards)} carries no "
                f"__sancov_guards - `bin/setup-target <slug> --build --force` "
                f"rebuilds it with -fsanitize-coverage=trace-pc-guard"
            )
        wanted = " or ".join(plain_tree + s for s in GENERIC_COVERAGE_SUFFIXES)
        return None, None, (
            f"no instrumented sibling build ({wanted}) carrying {Path(raw).name} - "
            f"`bin/setup-target <slug> --build` builds it "
            f"(see the directed-fuzzing guide)"
        )

    def _resolve_harness_twin(
        self, source: Path, plain_tree: str,
    ) -> tuple[Path | None, Path | None, str]:
        """A coverage twin of bin/probe's compiled harness, or why there is none.

        The sanitizer route was a harness bin/probe compiled against the plain
        library, so the route-equivalent coverage binary is that same source
        compiled with trace-pc-guard and linked against the coverage sibling's
        library, by the toolchain that built the sibling. Cached beside the
        other hits artifacts under the same identity discipline as probe's
        harness cache.
        """
        label = f"harness route {source.name}"
        if not source.is_file():
            return None, None, f"{label}: harness source not found: {source}"
        dispatch = languages.probe_dispatch(source.suffix)
        if dispatch is None or dispatch["build_kind"] != "cc":
            return None, None, (
                f"{label}: only C/C++ harnesses have a coverage twin"
            )
        raw = self.config.sanitizer_lib("asan") if self.config else ""
        if not raw:
            return None, None, (
                f"{label}: target.toml has no asan_lib, so there is no coverage "
                f"sibling library to link a twin against"
            )
        library: Path | None = None
        tree: Path | None = None
        without: list[str] = []
        stale_reasons: list[str] = []
        for suffix in GENERIC_COVERAGE_SUFFIXES:
            candidate = coverage_build.sibling_path(self.config, raw, "asan", suffix)
            if candidate is None or not candidate.is_file():
                continue
            if (fuzz_harness.is_coverage_instrumented(candidate)
                    or has_sancov_section(candidate)):
                stale = coverage_build.stale_reason(self.target_root, "asan", suffix)
                if stale:
                    stale_reasons.append(stale)
                    continue
                library, tree = candidate, self.target_root / (plain_tree + suffix)
                break
            without.append(plain_tree + suffix)
        if library is None or tree is None:
            if stale_reasons:
                return None, None, f"{label}: {stale_reasons[0]}"
            if without:
                return None, None, (
                    f"{label}: sibling build {' and '.join(without)} carries no "
                    f"SanitizerCoverage - `bin/setup-target <slug> --build --force` "
                    f"rebuilds it"
                )
            wanted = " or ".join(plain_tree + s for s in GENERIC_COVERAGE_SUFFIXES)
            return None, None, (
                f"{label}: no instrumented sibling build ({wanted}) carrying "
                f"{Path(raw).name} - `bin/setup-target <slug> --build` builds it"
            )
        compiler = fuzz_harness.compiler_for(source)
        compiler_path = shutil.which(compiler) or compiler
        flags = shlex.split(os.environ.get(dispatch["flags_env"], ""))
        try:
            compiler_stat = stat_key(Path(compiler_path))
        except OSError:
            compiler_stat = compiler_path
        identity = "\n".join((
            "schema=1", f"source={hashlib.sha1(source.read_bytes()).hexdigest()}",
            f"compiler={compiler_path}", f"compiler_stat={compiler_stat}",
            f"flags={flags}", f"library={library}", f"library_stat={stat_key(library)}",
            f"includes={self.config.includes}", f"defines={self.config.defines}",
            f"links={self.config.resolved_link_libs()}",
            f"ldflags={os.environ.get('LDFLAGS', '')}",
            f"target_rev={self.config.target_rev}",
        ))
        digest = hashlib.sha1(identity.encode()).hexdigest()
        twin = cache_dir() / f"{source.name}.{digest}.cov"
        log = cache_dir() / f"{source.name}.{digest}.cov.build.log"
        lock = cache_dir() / f"{source.name}.{digest}.cov.lock"
        command = fuzz_harness.probe_compile_command(
            compiler_path, "address", source, twin, self.config, str(library),
            flags, coverage=True,
        )
        with lock.open("a+") as stream:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
            try:
                if not os.access(twin, os.X_OK) and log.is_file():
                    # Same source, library and toolchain already failed; the
                    # identity changes when any of them does.
                    return None, None, (
                        f"{label}: coverage twin did not compile; log: {log}"
                    )
                if not os.access(twin, os.X_OK):
                    completed = subprocess.run(command, capture_output=True, check=False)
                    text = (completed.stdout + completed.stderr).decode(errors="replace")
                    if completed.returncode or not os.access(twin, os.X_OK):
                        twin.unlink(missing_ok=True)
                        log.write_text(shlex.join(command) + "\n\n" + text, encoding="utf-8")
                        return None, None, (
                            f"{label}: coverage twin did not compile "
                            f"(rc={completed.returncode}); log: {log}"
                        )
            finally:
                fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
        self.harness_twin = source
        return twin, tree, ""

    def _browser_from_config(self) -> Path:
        if self.config and self.config.asan_bin:
            configured = self.config.asan_bin
            configured = configured.replace(self.asan_build.name + "/", self.build.name + "/")
            return Path(self.config.resolve_path(configured))
        if sys.platform == "darwin":
            return self.build / "dist/Nightly.app/Contents/MacOS/firefox"
        return self.build / "dist/bin/firefox"

    def _default_xul(self) -> Path:
        if sys.platform == "darwin":
            return self.build / "dist/Nightly.app/Contents/MacOS/XUL"
        return self.build / "dist/bin/libxul.so"

    def validate(self) -> None:
        if self.args.mode == "browser":
            if not os.access(self.browser, os.X_OK):
                raise RuntimeError(
                    f"coverage browser missing: {self.browser} - prepare the "
                    "configured build-asan-cov tree first"
                )
            if not self.xul.is_file():
                raise RuntimeError(
                    f"coverage XUL missing: {self.xul} - prepare the configured "
                    "build-asan-cov tree first"
                )
            probe_sancov("XUL", self.xul)
        elif self.args.mode == "js":
            if not os.access(self.js, os.X_OK):
                raise RuntimeError(f"coverage js shell missing: {self.js}")
            probe_sancov("coverage js shell", self.js)
        else:  # generic
            probe_sancov("coverage binary", self.generic_binary)
        if not os.access(self.sancov, os.X_OK):
            raise RuntimeError(f"sancov not found at {self.sancov} - install LLVM tools or set LLVM_PREFIX")
        if self.args.mode == "generic":
            # PCs map to files through the harness's offline symbolizer, which
            # prefers debug-map-aware atos on macOS; llvm-symbolizer alone is
            # not required there.
            if not sanitizer.symbolize_available():
                raise RuntimeError(
                    "no offline symbolizer available (need atos, llvm-symbolizer, "
                    "or addr2line) - install LLVM tools or set LLVM_PREFIX"
                )
        elif not os.access(self.symbolizer, os.X_OK):
            raise RuntimeError(f"llvm-symbolizer not found at {self.symbolizer} - install LLVM tools or set LLVM_PREFIX")

    def append_verdict(self, verdict: str, frame: str = "") -> None:
        if not self.args.log:
            return
        destination = Path(self.args.log)
        destination.parent.mkdir(parents=True, exist_ok=True)
        timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        with destination.open("a") as stream:
            stream.write(
                f"{verdict} {timestamp} testcase={self.testcase} want={self.args.want!r} "
                f"edges={self.edge_count} new={self.new_edges} frame={frame or '<none>'}\n"
            )

    def run_target(self, coverage_dir: Path) -> tuple[Path, int | None]:
        option_string = f"detect_leaks=0:coverage=1:halt_on_error=0:coverage_dir={coverage_dir}"
        environment = sanitizer.prepare_runtime_env("asan")
        environment["ASAN_OPTIONS"] = option_string
        output = coverage_dir / "target-output.raw"
        if self.args.mode == "generic":
            if self.config:
                for entry in self.config.runner_env:
                    expanded = sanitizer_run.expand_runner_value(
                        entry, self.config, "asan", testcase=str(self.testcase),
                    )
                    key, value = expanded.split("=", 1)
                    environment[key] = value
            with output.open("wb") as stream:
                completed = run_timeout(
                    [str(self.generic_binary), *self._generic_command_args()],
                    self.args.timeout, env=environment,
                    cwd=sanitizer_run.configured_runner_cwd(
                        self.config, self.generic_binary, "asan",
                    ),
                    stdout=stream, stderr=subprocess.STDOUT,
                )
            # A run killed at the deadline dumps no .sancov, which is a
            # different answer from an instrumented binary that ran and
            # reached nothing. lib/timeout reserves 124 for the deadline.
            self.deadline_hit = completed.returncode == 124
            return output, None
        if self.args.mode == "js":
            flags: list[str] = []
            script_args: list[str] = []
            for arg in self.args.extra:
                if not script_args and arg.startswith("-"):
                    flags.append(arg)
                else:
                    script_args.append(arg)
            with output.open("wb") as stream:
                run_timeout(
                    [str(self.js), *flags, str(self.testcase), *script_args],
                    self.args.timeout, env=environment,
                    stdout=stream, stderr=subprocess.STDOUT,
                )
            return output, None

        environment.update({"MOZ_DISABLE_CONTENT_SANDBOX": "1", "MOZ_HEADLESS": "1"})
        with tempfile.TemporaryDirectory(prefix="hits-profile-") as profile_name:
            profile = Path(profile_name)
            prefs = PROFILE_PREFS
            if os.environ.get("FIREFOX_EXTRA_PREFS"):
                prefs += "\n" + os.environ["FIREFOX_EXTRA_PREFS"] + "\n"
            (profile / "user.js").write_text(prefs)
            (profile / "prefs.js").write_text(prefs)
            with output.open("wb") as stream:
                process = subprocess.Popen(
                    [str(self.browser), "--profile", str(profile), "--no-remote", *self.args.extra, self.testcase.resolve().as_uri()],
                    stdout=stream, stderr=subprocess.STDOUT, env=environment,
                    start_new_session=True,
                )
                parent_pid = process.pid
                deadline = time.monotonic() + self.args.timeout
                while process.poll() is None and time.monotonic() < deadline:
                    time.sleep(0.1)
                # A browser parent can exit before content processes. Always
                # close the unique process group before reading coverage.
                try:
                    os.killpg(parent_pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                group_deadline = time.monotonic() + 25
                while time.monotonic() < group_deadline:
                    try:
                        os.killpg(parent_pid, 0)
                    except ProcessLookupError:
                        break
                    time.sleep(0.1)
                else:
                    try:
                        os.killpg(parent_pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                try:
                    process.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            time.sleep(0.5)
            return output, parent_pid

    def _generic_command_args(self) -> list[str]:
        """The testcase and any extra args the configured binary is driven with.

        A native CLI usually takes the testcase positionally; a `[runner].args`
        template that names `{TESTCASE}` is expanded instead, so a target whose
        input arrives through a flag or sink argument is replayed the same way
        bin/probe replays it.
        """
        runner_args = list(self.config.runner_args) if self.config else []
        # A harness takes what bin/probe handed the sanitizer run: the
        # testcase (unless the route already carried it) and the trailing
        # arguments. A [runner] template describes the configured CLI, not
        # this program, so a twin never falls through to it.
        if self.harness_twin or self.args.extra:
            extra = list(self.args.extra)
            if extra[:1] == ["--"]:
                extra = extra[1:]
            skip = self.args.generic_skip_testcase or sanitizer.generic_skips_testcase(
                "asan"
            )
            return [*(() if skip else (str(self.testcase),)), *extra]
        if any("{TESTCASE}" in value for value in runner_args):
            expanded = [
                sanitizer_run.expand_runner_value(
                    value, self.config, "asan", testcase=str(self.testcase),
                )
                for value in runner_args
            ]
            return [*expanded, *self.args.extra]
        return [str(self.testcase), *self.args.extra]

    def binary_map(self) -> tuple[list[Path], Path]:
        dist = self.build / "dist/bin"
        if self.args.mode == "generic":
            # The binary plus any instrumented DSO it loaded from the sibling
            # tree; a .sancov file is named for the module it came from, so
            # symbolize resolves each against the right one.
            tree = self.generic_tree or self.generic_binary.parent
            # A .sancov is named for the module's real file, which on Linux
            # is the versioned `libx.so.1.2` behind the `libx.so` symlink.
            dsos = [path for path in tree.rglob("*") if _SHARED_OBJECT_RE.search(path.name)]
            return [self.generic_binary, *dsos], self.generic_binary
        if self.args.mode == "js":
            return [self.js, *dist.glob("*.dylib"), *dist.glob("*.so")], self.js
        if sys.platform == "darwin":
            mac = self.app / "Contents/MacOS"
            return [self.browser, self.xul, mac / "plugin-container", *mac.glob("*.dylib")], self.xul
        return [self.browser, self.xul, dist / "plugin-container", *dist.glob("*.so")], self.xul

    def symbolize_generic(self, coverage_dir: Path) -> tuple[list[str], list[str]]:
        """Map sancov PCs to source through the offline symbolizer.

        `sancov -print` yields raw module offsets; the offline symbolizer reads
        the `#N 0x0 (module+0xoffset)` frame shape, so each PC is rendered as a
        synthetic frame and resolved in one pass (atos on macOS, else
        llvm-symbolizer/addr2line). Resolved frames are emitted as the
        function/`file:line` line pairs `edges.extract` already parses. Generic
        mode has no parent/child split, so content is the full list.
        """
        binaries, fallback = self.binary_map()
        by_name = {path.name: path for path in binaries if path.is_file()}
        arch = platform.machine() if sys.platform == "darwin" else ""
        frames: list[str] = []
        by_binary: dict[str, list[str]] = {}
        for coverage in sorted(coverage_dir.glob("*.sancov")):
            stem = coverage.name.removesuffix(".sancov")
            base, _, _pid = stem.rpartition(".")
            target = by_name.get(base, fallback)
            module = f"{target}:{arch}" if arch else str(target)
            printed = subprocess.run(
                [str(self.sancov), "-print", str(coverage)],
                capture_output=True, text=True, check=False,
            ).stdout
            offsets = [token for token in printed.split() if token.startswith("0x")]
            for token in offsets:
                frames.append(f"    #0 0x0 ({module}+{token})")
            if offsets:
                by_binary.setdefault(str(target), []).extend(offsets)
        if not frames:
            return [], []
        lines, timed_out = self._batch_atos(by_binary, arch)
        if timed_out:
            # The tool, not the input: retrying it through the shared path
            # would spend the same budget wedging on the same binary.
            self.symbolize_timed_out = True
            return [], []
        if lines is None:
            lines = self._offline_symbolize(frames)
        if self.harness_twin is not None:
            # The twin's own frames resolve to the harness source, which the
            # symbolizer may print as a bare basename. They are not target
            # coverage: keeping them would let a harness file rank as a
            # subsystem and match a `want` that names it. A basename alone is
            # not proof — a harness may share its name with a target file — so
            # the function must also be one the harness itself defines.
            harness = self.harness_twin.name
            defined = _defined_functions(self.harness_twin)
            prefix = str(Path(self.config.results_dir)) if self.config and self.config.results_dir else ""
            kept: list[str] = []
            for function, location in zip(lines[::2], lines[1::2]):
                file_name = Path(location.rsplit(":", 1)[0]).name
                own = file_name == harness and function.split("(", 1)[0].strip() in defined
                if own or (prefix and location.startswith(prefix)):
                    continue
                kept.extend((function, location))
            lines = kept
        lines = self._target_relative(lines)
        return lines, lines

    def _target_relative(self, lines: list[str]) -> list[str]:
        """Key every location the way a work card names its file.

        Ranking and the coverage summary group edges by the target-relative
        path a card carries, so an absolute path is relativized and a frame
        outside the target tree — a system or toolchain header, the standard
        library — is dropped: it is not the target's coverage. A bare
        basename the symbolizer could not resolve further is kept as it is.
        """
        root = str(self.target_root.resolve())
        kept: list[str] = []
        for function, location in zip(lines[::2], lines[1::2]):
            path_text, colon, line_no = location.rpartition(":")
            if not colon or not line_no.isdigit():
                path_text, line_no = location, ""
            path = Path(path_text)
            if path.is_absolute():
                try:
                    relative = path.resolve().relative_to(root).as_posix()
                except (OSError, ValueError):
                    continue
                location = f"{relative}:{line_no}" if line_no else relative
            kept.extend((function, location))
        return kept

    @staticmethod
    def _batch_atos(
        by_binary: dict[str, list[str]], arch: str,
    ) -> "tuple[list[str] | None, bool]":
        """Resolve each module's whole offset list in one `atos` call, or None.

        The shared symbolizer speaks to atos one address at a time over a pty.
        A sandboxed agent shell can be denied a pty, and the fallback then
        spends one process per address: tolerable for a crash report's twenty
        frames, ruinous for a coverage run's hundreds, which overran the
        symbolizer's own 60s budget and left every probe with no coverage at
        all. atos answers a whole address list in one pass, so ask it that way.
        Addresses go on stdin because a list this long can outgrow the
        command-line limit.

        Returns (lines, timed_out). A None answer means "not answered here" —
        no atos, a failed call, or answers that do not line up with the
        addresses — and the caller keeps the shared path. Positional mapping is
        only sound when every address got exactly one answer, so a short answer
        declines rather than guesses.

        The call runs under the same deadline the shared symbolizer uses, and
        through the process-tree wrapper so a wedged atos cannot outlive it: an
        unbounded call here would hang the whole audit, since the coverage gate
        has no outer deadline of its own. A deadline is reported rather than
        declined, because spending the same budget again on the fallback would
        wedge on the same tool.
        """
        if sys.platform != "darwin" or not arch:
            return None, False
        atos = shutil.which("atos")
        if not atos:
            return None, False
        lines: list[str] = []
        for binary, offsets in by_binary.items():
            completed = run_timeout(
                [atos, "-o", binary, "-arch", arch, "-fullPath"],
                sanitizer.SYMBOLIZE_TIMEOUT_SECONDS,
                input="\n".join(offsets) + "\n",
                capture_output=True, text=True,
            )
            if completed.returncode == TIMEOUT_RC:
                return None, True
            if completed.returncode != 0:
                return None, False
            # The same progress chatter DarwinSymbolizer skips past.
            answers = [row.strip() for row in completed.stdout.splitlines()
                       if row.strip() and "got symbolicator for" not in row]
            if len(answers) != len(offsets):
                return None, False
            for answer in answers:
                resolved = ATOS_ANSWER_RE.match(answer)
                if resolved:
                    lines.append(resolved.group("function").strip())
                    lines.append(resolved.group("location"))
        return lines, False

    @staticmethod
    def _offline_symbolize(frames: list[str]) -> list[str]:
        with tempfile.TemporaryDirectory(prefix="hits-symbolize-") as tmp:
            report = Path(tmp) / "frames.txt"
            report.write_text("\n".join(frames) + "\n", encoding="utf-8")
            sanitizer.symbolize_file(report, full_path=True)
            resolved = report.read_text(encoding="utf-8", errors="replace")
        lines: list[str] = []
        for raw in resolved.splitlines():
            match = re.match(r"^\s*#\d+\s+\S+\s+in\s+(.*)$", raw)
            if not match:
                continue
            rest = match.group(1).strip()
            location = re.search(r"(\S+:\d+)$", rest)
            if location:
                function = rest[: location.start()].strip() or "??"
                lines.append(function)
                lines.append(location.group(1))
        return lines

    def symbolize(self, coverage_dir: Path, parent_pid: int | None) -> tuple[list[str], list[str]]:
        if self.args.mode == "generic":
            return self.symbolize_generic(coverage_dir)
        binaries, fallback = self.binary_map()
        by_name = {path.name: path for path in binaries if path.is_file()}
        all_lines: list[str] = []
        content_lines: list[str] = []
        for coverage in coverage_dir.glob("*.sancov"):
            stem = coverage.name.removesuffix(".sancov")
            base, _, pid_text = stem.rpartition(".")
            target = by_name.get(base, fallback)
            with tempfile.TemporaryDirectory(prefix="hits-symbolize-") as tmp:
                addresses = Path(tmp) / "addresses"
                symbolized = Path(tmp) / "symbolized"
                with addresses.open("wb") as output:
                    subprocess.run(
                        [str(self.sancov), "-print", str(coverage)],
                        stdout=output, stderr=subprocess.DEVNULL, check=False,
                    )
                with addresses.open("rb") as source, symbolized.open("wb") as output:
                    subprocess.run(
                        [str(self.symbolizer), "-e", str(target), "--inlines", "--demangle"],
                        stdin=source, stdout=output, stderr=subprocess.DEVNULL, check=False,
                    )
                with symbolized.open(encoding="utf-8", errors="replace") as source:
                    for raw in source:
                        line = raw.rstrip("\n")
                        all_lines.append(line)
                        if self.args.mode == "js" or parent_pid is None or pid_text != str(parent_pid):
                            content_lines.append(line)
        return all_lines, content_lines

    def write_hits(self, lines: list[str], content: list[str]) -> Path:
        if self.args.save:
            destination = Path(self.args.save)
        else:
            fd, name = tempfile.mkstemp(prefix="hits-list-")
            os.close(fd)
            destination = Path(name)
        destination.write_text("\n".join(lines) + ("\n" if lines else ""))
        Path(str(destination) + ".content").write_text("\n".join(content) + ("\n" if content else ""))
        return destination

    def update_edges(self, hits_file: Path) -> None:
        try:
            extracted = edges.extract(hits_file)
            self.edge_count = len(extracted)
            if self.args.slug and extracted:
                with tempfile.NamedTemporaryFile(mode="w") as run_edges:
                    run_edges.write("\n".join(extracted) + "\n")
                    run_edges.flush()
                    self.new_edges = len(edges.diff_new(self.args.slug, run_edges.name))
                    if self.new_edges:
                        edges.record_run(self.args.slug, str(self.args.agent), run_edges.name)
        except OSError:
            self.edge_count = self.new_edges = 0

    def result(self, hits_file: Path, all_lines: list[str], content: list[str]) -> int:
        self.update_edges(hits_file)
        print(f"EDGES_HIT: {self.edge_count}")
        print(f"NEW_EDGES: {self.new_edges}")
        content_match = next((line for line in content if self.want.search(line)), "")
        full_match = next((line for line in all_lines if self.want.search(line)), "")
        match = content_match or full_match
        if match:
            if not content_match and content and not any(value in self.args.want for value in ("chrome/", "browser/", "toolkit/components/")):
                print(f"MISSED - want symbol only seen in parent process (likely startup noise): {match}")
                print(f"hits-file: {hits_file}", file=sys.stderr)
                self.append_verdict("MISSED:", f"parent-only:{match}")
                return 1
            print(f"HIT: {match}")
            print(f"hits-file: {hits_file}", file=sys.stderr)
            self.append_verdict("HIT:", match)
            return 0
        closest = self.closest(content, all_lines)
        if closest:
            print(f"MISSED - closest reached: {closest}")
            self.append_verdict("MISSED:", closest)
        else:
            print("MISSED - NO_PROXIMITY: testcase ran but no want-related code executed (likely upstream guard rejection)")
            self.append_verdict("MISSED:", "NO_PROXIMITY")
        print(f"hits-file: {hits_file}", file=sys.stderr)
        return 1

    def closest(self, content: list[str], all_lines: list[str]) -> str:
        tokens = re.findall(r"[A-Za-z_][A-Za-z_0-9:./]+", self.args.want.replace("\\", ""))
        tokens = sorted(set(tokens), key=lambda token: (-len(token), token))
        for token in tokens:
            if len(token) < 5:
                continue
            for label, pool in (("content", content), ("full", all_lines)):
                line = next((line for line in pool if token in line and not NOISE_RE.search(line)), "")
                if line:
                    return f"{line} [pool={label} (token={token})]"
        line = next((line for line in content if not NOISE_RE.search(line)), "")
        return f"{line} [pool=content (denoised head)]" if line else ""

    def _coverage_context(self):
        """Where the run drops its .sancov files.

        Generic mode writes under RESULTS_DIR/coverage/ so the path stays inside
        the directories a sandboxed audit may write, and is per-agent so
        parallel workers never share it; a fresh directory each run keeps stale
        PCs from an earlier testcase out. Browser/JS keep the private temp dir.
        """
        if self.args.mode == "generic":
            base = (
                self.config.results_dir if self.config and self.config.results_dir
                else os.environ.get("RESULTS_DIR", "")
            )
            if base:
                directory = Path(base) / "coverage" / f"sancov-{self.args.agent}"
                shutil.rmtree(directory, ignore_errors=True)
                directory.mkdir(parents=True, exist_ok=True)
                return contextlib.nullcontext(str(directory))
        return tempfile.TemporaryDirectory(prefix="hits-cov-")

    def _no_coverage_reason(self, coverage_dir: Path) -> "tuple[str, str]":
        """Why this run produced no coverage, as a label the gate can record.

        One generic failure covered three unrelated causes, and telling them
        apart is the difference between "fix the testcase", "fix the build"
        and "fix the toolchain". The exit code is unchanged — coverage still
        falls open and the sanitizer still runs — so this sharpens the record
        without moving a decision.
        """
        if self.deadline_hit:
            return (
                "COVERAGE_TIMEOUT",
                f"the instrumented run was killed at its {self.args.timeout}s "
                "deadline before it could dump coverage",
            )
        if not any(coverage_dir.glob("*.sancov")):
            return (
                "COVERAGE_NO_SANCOV",
                "the run wrote no sancov files (an uninstrumented binary, or "
                "one that never exited cleanly)",
            )
        if self.symbolize_timed_out:
            return (
                "COVERAGE_SYMBOLIZE_FAIL",
                "the symbolizer was killed at its "
                f"{sanitizer.SYMBOLIZE_TIMEOUT_SECONDS}s deadline with the "
                "run's PCs still unresolved",
            )
        return (
            "COVERAGE_SYMBOLIZE_FAIL",
            "sancov files were written but none of their PCs resolved to a "
            "source location (a stripped build, a moved binary, or a "
            "symbolizer that could not run)",
        )

    def run(self) -> int:
        if self.args.mode == "generic" and self.generic_binary is None:
            # No instrumented tree to measure against. Report it plainly so the
            # caller can proceed ungated; this is never a coverage miss.
            print(f"COVERAGE_UNAVAILABLE: {self.generic_reason}")
            self.append_verdict("COVERAGE_UNAVAILABLE:", self.generic_reason)
            return 4
        self.validate()
        with self._coverage_context() as coverage_name:
            coverage_dir = Path(coverage_name)
            output, parent_pid = self.run_target(coverage_dir)
            if self.args.mode == "browser" and output.stat().st_size == 0:
                print("EXEC_FAIL - browser produced no stdout/stderr at all (launch failure)")
                self.append_verdict("EXEC_FAIL:")
                return 3
            all_lines, content = self.symbolize(coverage_dir, parent_pid)
            hits_file = self.write_hits(all_lines, content)
            if not all_lines:
                label, detail = self._no_coverage_reason(coverage_dir)
                print(f"{label} - {detail}")
                print(f"hits-file: {hits_file}", file=sys.stderr)
                self.append_verdict(f"{label}:", detail)
                return 3
            return self.result(hits_file, all_lines, content)


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if args.extra and args.extra[0] == "--":
        args.extra.pop(0)
    try:
        return Hits(args).run()
    except (ValueError, RuntimeError, OSError) as exc:
        print(f"[hits] {exc}", file=sys.stderr)
        return 2
    except Exception:  # noqa: BLE001 - a defect here must not read as a miss
        # The gate reads exit 1 as MISSED. An interpreter exit from an
        # unhandled defect is 1 too, so it would count as reached-nothing and,
        # in gated modes, skip the sanitizer. Say what broke and fail as the
        # environment failure it is.
        traceback.print_exc()
        print("[hits] internal error; coverage is unavailable for this run", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
